{
  // Case 2 stability eigensolver convergence ladder on the fixed no-corner BC recipe.
  // Goal: track how many modes survive the explicit/postchecked residual gate
  // as we tighten EPS tolerance and ask for more eigenpairs.
  //
  // Run with:
  //   LINSTAB2D_CASE_MODULE=case2 \
  //   LINSTAB2D_CASE1_PERF_CONFIG=results/case2/eigs_convergence_cases.jsonc \
  //   ../../.venv/bin/python results/case1/perf_memory.py

  "outputs": {
    "report_json": "output/eigs_convergence/case2_eigs_convergence_latest.json",
    "report_csv": "output/eigs_convergence/case2_eigs_convergence_table.csv",
    "log_dir": "output/eigs_convergence/logs",
    "run_dir": "output/eigs_convergence/runs"
  },

  "defaults": {
    "base_config": "parity_config.jsonc",
    "case_workdir": ".",
    "monitor_interval_seconds": 0.5,
    "python_exe": "../../.venv/bin/python",
    "env": {
      "OMP_NUM_THREADS": "1",
      "OPENBLAS_NUM_THREADS": "1",
      "MKL_NUM_THREADS": "1",
      "NUMEXPR_NUM_THREADS": "1"
    },
    "launcher": {
      "mpi_procs": 10,
      "launcher": "mpiexec"
    },
    "case_defaults": {
      "config_overrides": {
        "numerics": {
          "stride_ksi": 1,
          "stride_eta": 1,
          "fd_order": 4,
          "beta": 0.0,
          "alpha_filter": 0.0
        },
        "analysis": {
          "ratio_uinf": 1.0,
          "ratio_l": 0.1,
          "St": 0.1,
          "run_stability": true,
          "run_resolvent": false
        },
        "solver": {
          "petsc_matrix_mode": "distributed",
          "eigen": {
            "st_solver": "mumps",
            "conv_test": "rel",
            "true_residual": true,
            "residual_error_type": "relative",
            "extract_all_converged": true,
            "monitor": true,
            "monitor_every": 10,
            "eps_max_it": 800
          }
        }
      }
    }
  },

  "cases": [
    {
      "case_id": "case2_stability_fd4_nev10_ncv80_tol1e4",
      "label": "Case 2 stability fd4 nev10 ncv80 tol1e-4",
      "enabled": true,
      "config_overrides": {
        "analysis": {"n_modes_stability": 10},
        "solver": {"eigen": {"ncv": 80, "eps_tol": 1e-4}}
      }
    },
    {
      "case_id": "case2_stability_fd4_nev10_ncv80_tol1e5",
      "label": "Case 2 stability fd4 nev10 ncv80 tol1e-5",
      "enabled": true,
      "config_overrides": {
        "analysis": {"n_modes_stability": 10},
        "solver": {"eigen": {"ncv": 80, "eps_tol": 1e-5}}
      }
    },
    {
      "case_id": "case2_stability_fd4_nev10_ncv80_tol1e6",
      "label": "Case 2 stability fd4 nev10 ncv80 tol1e-6",
      "enabled": true,
      "config_overrides": {
        "analysis": {"n_modes_stability": 10},
        "solver": {"eigen": {"ncv": 80, "eps_tol": 1e-6}}
      }
    },

    {
      "case_id": "case2_stability_fd4_nev20_ncv120_tol1e4",
      "label": "Case 2 stability fd4 nev20 ncv120 tol1e-4",
      "enabled": true,
      "config_overrides": {
        "analysis": {"n_modes_stability": 20},
        "solver": {"eigen": {"ncv": 120, "eps_tol": 1e-4}}
      }
    },
    {
      "case_id": "case2_stability_fd4_nev20_ncv120_tol1e5",
      "label": "Case 2 stability fd4 nev20 ncv120 tol1e-5",
      "enabled": true,
      "config_overrides": {
        "analysis": {"n_modes_stability": 20},
        "solver": {"eigen": {"ncv": 120, "eps_tol": 1e-5}}
      }
    },
    {
      "case_id": "case2_stability_fd4_nev20_ncv120_tol1e6",
      "label": "Case 2 stability fd4 nev20 ncv120 tol1e-6",
      "enabled": true,
      "config_overrides": {
        "analysis": {"n_modes_stability": 20},
        "solver": {"eigen": {"ncv": 120, "eps_tol": 1e-6}}
      }
    },

    {
      "case_id": "case2_stability_fd4_nev50_ncv200_tol1e4",
      "label": "Case 2 stability fd4 nev50 ncv200 tol1e-4",
      "enabled": true,
      "config_overrides": {
        "analysis": {"n_modes_stability": 50},
        "solver": {"eigen": {"ncv": 200, "eps_tol": 1e-4}}
      }
    },
    {
      "case_id": "case2_stability_fd4_nev50_ncv200_tol1e5",
      "label": "Case 2 stability fd4 nev50 ncv200 tol1e-5",
      "enabled": true,
      "config_overrides": {
        "analysis": {"n_modes_stability": 50},
        "solver": {"eigen": {"ncv": 200, "eps_tol": 1e-5}}
      }
    },
    {
      "case_id": "case2_stability_fd4_nev50_ncv200_tol1e6",
      "label": "Case 2 stability fd4 nev50 ncv200 tol1e-6",
      "enabled": true,
      "config_overrides": {
        "analysis": {"n_modes_stability": 50},
        "solver": {"eigen": {"ncv": 200, "eps_tol": 1e-6}}
      }
    },

    {
      "case_id": "case2_stability_fd4_nev100_ncv300_tol1e4",
      "label": "Case 2 stability fd4 nev100 ncv300 tol1e-4",
      "enabled": true,
      "config_overrides": {
        "analysis": {"n_modes_stability": 100},
        "solver": {"eigen": {"ncv": 300, "eps_tol": 1e-4}}
      }
    },
    {
      "case_id": "case2_stability_fd4_nev100_ncv300_tol1e5",
      "label": "Case 2 stability fd4 nev100 ncv300 tol1e-5",
      "enabled": true,
      "config_overrides": {
        "analysis": {"n_modes_stability": 100},
        "solver": {"eigen": {"ncv": 300, "eps_tol": 1e-5}}
      }
    },
    {
      "case_id": "case2_stability_fd4_nev100_ncv300_tol1e6",
      "label": "Case 2 stability fd4 nev100 ncv300 tol1e-6",
      "enabled": true,
      "config_overrides": {
        "analysis": {"n_modes_stability": 100},
        "solver": {"eigen": {"ncv": 300, "eps_tol": 1e-6}}
      }
    }
  ]
}

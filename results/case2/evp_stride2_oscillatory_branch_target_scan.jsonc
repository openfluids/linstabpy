{
  "$include": "_defaults.jsonc",
  "outputs": {
    "report_json": "output/evp_stride2_oscillatory_branch_target_scan/case2_evp_stride2_oscillatory_branch_target_scan_latest.json",
    "report_csv": "output/evp_stride2_oscillatory_branch_target_scan/case2_evp_stride2_oscillatory_branch_target_scan_table.csv",
    "log_dir": "output/evp_stride2_oscillatory_branch_target_scan/logs",
    "run_dir": "output/evp_stride2_oscillatory_branch_target_scan/runs"
  },
  "defaults": {
    "case_defaults": {
      "config_overrides": {
        "numerics": {
          "stride_ksi": 2,
          "stride_eta": 2
        },
        "analysis": {
          "n_modes_stability": 20,
          "stability_acceptance": {
            "postcheck_rel_max": 1e-05,
            "target_distance_max": 0.35,
            "omega_real_abs_max": 2.0,
            "omega_imag_abs_max": 2.0
          }
        },
        "solver": {
          "eigen": {
            "eps_tol": 1e-05,
            "eps_max_it": 800,
            "ncv": 400
          }
        }
      }
    }
  },
  "cases": [
    {
      "case_id": "target_branch_0p45_m1p00",
      "label": "stride2 branch target 0.45-1.00i",
      "enabled": true,
      "config_overrides": {
        "analysis": {
          "omega_target": {
            "real": 0.45,
            "imag": -1.0
          }
        }
      }
    },
    {
      "case_id": "target_branch_0p55_m1p10",
      "label": "stride2 branch target 0.55-1.10i",
      "enabled": true,
      "config_overrides": {
        "analysis": {
          "omega_target": {
            "real": 0.55,
            "imag": -1.1
          }
        }
      }
    },
    {
      "case_id": "target_branch_0p65_m1p20",
      "label": "stride2 branch target 0.65-1.20i",
      "enabled": true,
      "config_overrides": {
        "analysis": {
          "omega_target": {
            "real": 0.65,
            "imag": -1.2
          }
        }
      }
    }
  ]
}

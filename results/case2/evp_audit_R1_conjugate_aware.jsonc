{
  // AUDIT R1 — Front B verification.
  //
  // Fork of evp_stride2x1_oscillatory_target_exact_smoke.jsonc with:
  //   - n_modes_stability: 4 (give headroom so both conjugates can fit)
  //   - analysis.stability_acceptance.conjugate_aware: true (Front B opt-in)
  //   - keep target_distance_max=0.15 tight so the distance-gate must be
  //     conjugate-aware to admit the physical conjugate at ω ≈ -0.56-1.11j
  //
  // Expected: with Front B on, both ω ≈ +0.56-1.11j (primary) AND its
  // conjugate ω ≈ -0.56-1.11j should be accepted if ARPACK converges
  // them. Without Front B (old behavior), only the primary survives.
  //
  // Run: from results/case2 on c8 with:
  //   .venv/bin/python perf_memory.py evp_audit_R1_conjugate_aware.jsonc
  "$include": "_defaults.jsonc",
  "outputs": {
    "report_json": "output/evp_audit_R1_conjugate_aware/case2_evp_audit_R1_conjugate_aware_latest.json",
    "report_csv":  "output/evp_audit_R1_conjugate_aware/case2_evp_audit_R1_conjugate_aware_table.csv",
    "log_dir":     "output/evp_audit_R1_conjugate_aware/logs",
    "run_dir":     "output/evp_audit_R1_conjugate_aware/runs"
  },
  "defaults": {
    "case_defaults": {
      "config_overrides": {
        "numerics": {
          "stride_ksi": 4,
          "stride_eta": 4
        },
        "analysis": {
          "n_modes_stability": 4,
          "stability_acceptance": {
            "postcheck_rel_max":      1e-04,
            "target_distance_max":    0.15,
            "omega_real_abs_max":     1.5,
            "omega_imag_abs_max":     2.0,
            "conjugate_aware":        true
          }
        },
        "solver": {
          "eigen": {
            "eps_tol":    1e-04,
            "eps_max_it": 300,
            "ncv":        40
          }
        }
      }
    }
  },
  "cases": [
    {
      "case_id": "audit_R1_conjugate_aware_stride2x1",
      "label":   "R1 Front B — conjugate-aware at target 0.561-1.112i",
      "enabled": true,
      "config_overrides": {
        "analysis": {
          "omega_target": { "real": 0.561107, "imag": -1.112186 }
        }
      }
    }
  ]
}

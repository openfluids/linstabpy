{
  // Etapa 2 do tutorial Ducros: sensor + filtro binomial leve.
  // Roda DEPOIS da etapa 1, com os mesmos thresholds que você validou lá.
  //
  // Objetivo: comparar espectro/modos com e sem cleanup e decidir se o
  // filtro removeu só ruído numérico ou se alterou física.
  //
  // Rodar:
  //   bash results/case2/ducros/run.sh results/case2/ducros/02_sensor_filter.jsonc

  "base_config": "../parity_config.jsonc",
  // output_dir is resolved by the runner relative to legacy/, so "../ducros/..."
  // lands inside results/case2/ducros/output/.
  "output_dir": "../ducros/output/02_sensor_filter",

  "experiment": {
    "run_baseline": true,
    "run_cleaned": true,
    "run_stability": true,
    "run_resolvent": true,
    "plot_fields": ["rho", "u", "v", "T"],
    "save_mode_count": 3
  },

  "config_overrides": {
    "paths": {
      // load_hamada_case is resolved by the legacy runner relative to legacy/,
      // so "../baseflow" lands in results/case2/baseflow.
      "case_dir": "../baseflow"
    },
    "numerics": {
      "stride_ksi": 4,
      "stride_eta": 4
    },
    "analysis": {
      "n_modes_stability": 6,
      "n_modes_resolvent": 2,
      "run_stability": true,
      "run_resolvent": true
    },
    "solver": {
      "eigen": {
        "ncv": 40,
        "eps_tol": 1e-5
      },
      "resolvent": {
        "type": "mumps",
        "eigen": {
          "eps_tol": 1e-6,
          "eps_max_it": 400
        }
      },
      "linsolve": {
        "type": "mumps"
      }
    }
  },

  "shock_cleanup": {
    "enabled": true,
    "sensor": {
      "enabled": true,
      "kind": "compression_ducros",
      // Valores calibrados na etapa 1. Ajuste conforme o cleanup_mask.png que você gerou lá.
      "compression_threshold": -5.0,
      "ducros_threshold": 0.9,
      "eps": 1e-14,
      "buffer_cells": 3,
      "blend_sigma": 0.0
    },
    "filter": {
      "enabled": true,
      // Comece com 1. Se o espectro ainda tem modos espúrios, suba pra 2.
      "passes": 1,
      "directions": ["x", "y"],
      // w tipicamente é irrelevante em 2D; pule.
      "fields": ["rho", "u", "v", "T"]
    },
    "sponge": {
      // Deixado desligado. Só ligue depois que etapa 2 estiver validada.
      "enabled": false,
      "amplitude": 0.0,
      "mode": "add",
      "smooth_sigma": 0.0
    }
  }
}

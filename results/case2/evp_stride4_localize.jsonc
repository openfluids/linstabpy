{
  // Active Case 2 EVP campaign, phase 1:
  // stride-4 branch localization with filter disabled and shock cleanup off.
  //
  // Run with:
  //   LINSTAB2D_CASE2_PERF_CONFIG=results/case2/evp_stride4_localize.jsonc \
  //   ../../.venv/bin/python results/case2/perf_memory.py

  "outputs": {
    "report_json": "output/evp_stride4_localize/case2_evp_stride4_localize_latest.json",
    "report_csv": "output/evp_stride4_localize/case2_evp_stride4_localize_table.csv",
    "log_dir": "output/evp_stride4_localize/logs",
    "run_dir": "output/evp_stride4_localize/runs"
  },

  "defaults": {
    "base_config": "parity_config.jsonc",
    "case_workdir": ".",
    "monitor_interval_seconds": 0.5,
    "python_exe": "../../.venv/bin/python",
    "env": {
      "OMP_NUM_THREADS": "1",
      "OPENBLAS_NUM_THREADS": "1",
      "MKL_NUM_THREADS": "1",
      "NUMEXPR_NUM_THREADS": "1"
    },
    "launcher": {
      "mpi_procs": 10,
      "launcher": "mpiexec --rankfile /home/ghamada/linstabpy/results/case2/socket0.rankfile --bind-to core"
    },
    "case_defaults": {
      "config_overrides": {
        "numerics": {
          "stride_ksi": 4,
          "stride_eta": 4,
          "fd_order": 4,
          "beta": 0.0,
          "alpha_filter": "none"
        },
        "analysis": {
          "ratio_uinf": 1.0,
          "ratio_l": 0.1,
          "St": 0.1,
          "run_stability": true,
          "run_resolvent": false,
          "n_modes_stability": 2,
          "stability_acceptance": {
            "postcheck_rel_max": 1e-4,
            "target_distance_max": 0.5,
            "omega_real_abs_max": 6.283185307179586,
            "omega_imag_abs_max": 1.0
          }
        },
        "solver": {
          "petsc_matrix_mode": "distributed",
          "eigen": {
            "st_solver": "mumps",
            "eps_tol": 5e-5,
            "conv_test": "rel",
            "true_residual": true,
            "residual_error_type": "relative",
            "extract_all_converged": true,
            "monitor": true,
            "monitor_every": 5,
            "eps_max_it": 200,
            "ncv": 40
          },
          "linsolve": {
            "type": "mumps"
          }
        }
      }
    }
  },

  "cases": [
    {
      "case_id": "target_steady_m011",
      "label": "stride4 target 0-0.109i",
      "enabled": true,
      "config_overrides": {
        "analysis": {
          "omega_target": {
            "real": 0.0,
            "imag": -0.109141476955
          }
        }
      }
    },
    {
      "case_id": "target_lowfreq_m0705",
      "label": "stride4 target 0-0.705i",
      "enabled": true,
      "config_overrides": {
        "analysis": {
          "omega_target": {
            "real": 0.0,
            "imag": -0.704804200672
          }
        }
      }
    },
    {
      "case_id": "target_box_0p326_m0p292",
      "label": "stride4 target 0.326-0.292i",
      "enabled": true,
      "config_overrides": {
        "analysis": {
          "omega_target": {
            "real": 0.325638043091,
            "imag": -0.291981984069
          }
        }
      }
    },
    {
      "case_id": "target_box_0p596_m0p429",
      "label": "stride4 target 0.596-0.429i",
      "enabled": true,
      "config_overrides": {
        "analysis": {
          "omega_target": {
            "real": 0.595547134892,
            "imag": -0.428743456273
          }
        }
      }
    }
  ]
}

{
  // Fast reduced-grid shock-cleanup comparison at zero frequency / zero spanwise wavenumber.
  //
  // Purpose:
  // - inspect the leading resolvent mode at omega = 0, beta = 0
  // - compare raw vs cleaned mean flow without touching the default workflow
  // - keep the run cheap enough for rapid iteration

  "base_config": "parity_config.jsonc",
  "output_dir": "output/shock_cleanup_experiment_zeroomega_yonly_fast",

  "experiment": {
    "run_baseline": true,
    "run_cleaned": true,
    "run_stability": false,
    "run_resolvent": true,
    "plot_fields": ["rho", "u", "v", "T"],
    "save_mode_count": 2
  },

  "config_overrides": {
    "numerics": {
      "stride_ksi": 4,
      "stride_eta": 4,
      "beta": 0.0
    },
    "analysis": {
      "omega_target": [0.0, 0.0],
      "n_modes_resolvent": 2,
      "run_stability": false,
      "run_resolvent": true
    },
    "solver": {
      "petsc_matrix_mode": "distributed",
      "resolvent": {
        "type": "mumps",
        "eigen": {
          "eps_tol": 1e-6,
          "eps_max_it": 300,
          "ncv": 30
        }
      },
      "linsolve": {
        "type": "mumps"
      }
    }
  },

  "shock_cleanup": {
    "enabled": true,
    "sensor": {
      "enabled": true,
      "kind": "compression_ducros",
      "compression_threshold": -5.0,
      "ducros_threshold": 0.9,
      "eps": 1e-14,
      "buffer_cells": 3,
      "blend_sigma": 0.0
    },
    "filter": {
      "enabled": true,
      "passes": 1,
      "directions": ["y"],
      "fields": ["rho", "u", "v", "T"]
    },
    "sponge": {
      "enabled": false,
      "amplitude": 0.0,
      "mode": "add",
      "smooth_sigma": 0.0
    }
  }
}

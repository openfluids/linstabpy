{
  "$include": "_defaults.jsonc",
  "outputs": {
    "report_json": "output/evp_stride2_target_real6p283_nev50/case2_evp_stride2_target_real6p283_nev50_latest.json",
    "report_csv": "output/evp_stride2_target_real6p283_nev50/case2_evp_stride2_target_real6p283_nev50_table.csv",
    "log_dir": "output/evp_stride2_target_real6p283_nev50/logs",
    "run_dir": "output/evp_stride2_target_real6p283_nev50/runs"
  },
  "defaults": {
    "case_defaults": {
      "config_overrides": {
        "numerics": {
          "stride_ksi": 2,
          "stride_eta": 2
        },
        "analysis": {
          "n_modes_stability": 50,
          "stability_acceptance": {
            "postcheck_rel_max": 1e-05,
            "target_distance_max": 0.5,
            "omega_real_abs_max": 6.283185307179586,
            "omega_imag_abs_max": 1.0
          }
        },
        "solver": {
          "eigen": {
            "eps_tol": 0.0001,
            "eps_max_it": 800,
            "ncv": 400
          }
        }
      }
    }
  },
  "cases": [
    {
      "case_id": "target_real6p283_nev50",
      "label": "stride2 target 6.283+0i nev50",
      "enabled": true,
      "config_overrides": {
        "analysis": {
          "omega_target": {
            "real": 6.283185307179586,
            "imag": 0.0
          }
        }
      }
    }
  ]
}

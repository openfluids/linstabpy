{
  // Reduced Case 2 reproducer for fd4 vs fd6 at the same oscillatory target.
  //
  // Why this exists:
  // - the M2 full-grid fd6 solve is too slow for interactive diagnosis here;
  // - we still want the same Case 2 path, same target, same solver family,
  //   but on a smaller symmetric stride to compare the dominant returned pair.
  "$include": "_defaults.jsonc",
  "outputs": {
    "report_json": "output/evp_stride4_m4_fd4_fd6_exact_smoke/case2_evp_stride4_m4_fd4_fd6_exact_smoke_latest.json",
    "report_csv": "output/evp_stride4_m4_fd4_fd6_exact_smoke/case2_evp_stride4_m4_fd4_fd6_exact_smoke_table.csv",
    "log_dir": "output/evp_stride4_m4_fd4_fd6_exact_smoke/logs",
    "run_dir": "output/evp_stride4_m4_fd4_fd6_exact_smoke/runs"
  },
  "defaults": {
    "launcher": {
      "mpi_procs": 1
    },
    "case_defaults": {
      "config_overrides": {
        "numerics": {
          "stride_ksi": 4,
          "stride_eta": 4
        },
        "analysis": {
          "n_modes_stability": 2,
          "omega_target": {
            "real": 0.561107,
            "imag": -1.112186
          },
          "stability_acceptance": {
            "postcheck_rel_max": 5e-05,
            "target_distance_max": 0.15,
            "omega_real_abs_max": 1.5,
            "omega_imag_abs_max": 2.0
          }
        },
        "solver": {
          "eigen": {
            "eps_tol": 1e-05,
            "eps_max_it": 300,
            "ncv": 80
          }
        }
      }
    }
  },
  "cases": [
    {
      "case_id": "target_branch_m4_fd4_exact_smoke",
      "label": "M4 exact branch target, fd4",
      "enabled": true,
      "config_overrides": {
        "numerics": {
          "fd_order": 4
        }
      }
    },
    {
      "case_id": "target_branch_m4_fd6_exact_smoke",
      "label": "M4 exact branch target, fd6",
      "enabled": true,
      "config_overrides": {
        "numerics": {
          "fd_order": 6
        }
      }
    }
  ]
}

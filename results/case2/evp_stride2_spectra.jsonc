{
  // Active Case 2 EVP campaign:
  // stride-2 baseline spectra with the mesh filter disabled and shock cleanup off.
  //
  // This is the only active campaign JSONC in results/case2/.
  // Older stride-4 and exploratory stride-2 probes were moved to legacy/.
  //
  // Run with:
  //   LINSTAB2D_CASE2_PERF_CONFIG=results/case2/evp_stride2_spectra.jsonc \
  //   ../../.venv/bin/python results/case2/perf_memory.py

  "outputs": {
    "report_json": "output/evp_stride2_spectra/case2_evp_stride2_spectra_latest.json",
    "report_csv": "output/evp_stride2_spectra/case2_evp_stride2_spectra_table.csv",
    "log_dir": "output/evp_stride2_spectra/logs",
    "run_dir": "output/evp_stride2_spectra/runs"
  },

  "defaults": {
    "base_config": "parity_config.jsonc",
    "case_workdir": ".",
    "monitor_interval_seconds": 0.5,
    "python_exe": "../../.venv/bin/python",
    "env": {
      "OMP_NUM_THREADS": "1",
      "OPENBLAS_NUM_THREADS": "1",
      "MKL_NUM_THREADS": "1",
      "NUMEXPR_NUM_THREADS": "1"
    },
    "launcher": {
      "mpi_procs": 10,
      "launcher": "mpiexec --rankfile /home/ghamada/linstabpy/results/case2/socket0.rankfile --bind-to core"
    },
    "case_defaults": {
      "config_overrides": {
        "numerics": {
          "stride_ksi": 2,
          "stride_eta": 2,
          "fd_order": 4,
          "beta": 0.0,
          "alpha_filter": "none"
        },
        "analysis": {
          "ratio_uinf": 1.0,
          "ratio_l": 0.1,
          "St": 0.1,
          "run_stability": true,
          "run_resolvent": false,
          "n_modes_stability": 6,
          "stability_acceptance": {
            "postcheck_rel_max": 1e-5,
            "target_distance_max": 0.5,
            "omega_real_abs_max": 6.283185307179586,
            "omega_imag_abs_max": 1.0
          }
        },
        "solver": {
          "petsc_matrix_mode": "distributed",
          "eigen": {
            "st_solver": "mumps",
            "eps_tol": 1e-5,
            "conv_test": "rel",
            "true_residual": true,
            "residual_error_type": "relative",
            "extract_all_converged": true,
            "monitor": true,
            "monitor_every": 5,
            "eps_max_it": 400,
            "ncv": 200
          },
          "linsolve": {
            "type": "mumps"
          }
        }
      }
    }
  },

  "cases": [
    {
      "case_id": "target_stationary_m085",
      "label": "stride2 target 0-0.85i",
      "enabled": true,
      "config_overrides": {
        "analysis": {
          "omega_target": {
            "real": 0.0,
            "imag": -0.85
          }
        }
      }
    }
  ]
}

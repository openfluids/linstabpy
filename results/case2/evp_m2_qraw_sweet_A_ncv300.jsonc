{
  // Sweet-spot sweep A (2026-04-20). Hypothesis: the tight-certify
  // stagnation was caused by shrinking ncv 6.25× (500 → 80) at the
  // same time we tightened eps_tol (5e-3 → 1e-8). The target
  // ω=(0, -0.6948i) IS an eigenvalue of L (classifier CSV mode 0,
  // shock_foot_frac=67%) — it's just embedded in a dense wall-local
  // cluster, and a small subspace cannot resolve it at tight tol.
  //
  // Config A: keep nev=4, restore ncv=300, keep tight tol. If the
  // subspace was the bottleneck, this converges in <200 iters.
  // max_it=200 so a failure shows up fast.
  "$include": "_defaults.jsonc",
  "outputs": {
    "report_json": "output/evp_m2_qraw_sweet_A_ncv300/case2_evp_m2_qraw_sweet_A_ncv300_latest.json",
    "report_csv":  "output/evp_m2_qraw_sweet_A_ncv300/case2_evp_m2_qraw_sweet_A_ncv300_table.csv",
    "log_dir":     "output/evp_m2_qraw_sweet_A_ncv300/logs",
    "run_dir":     "output/evp_m2_qraw_sweet_A_ncv300/runs"
  },
  "defaults": {
    "case_defaults": {
      "config_overrides": {
        "numerics": {"stride_ksi": 2, "stride_eta": 2},
        "analysis": {
          "n_modes_stability": 4,
          "stability_acceptance": {
            "postcheck_rel_max": 1e-6,
            "target_distance_max": 0.3,
            "omega_real_abs_max": 5.0,
            "omega_imag_abs_max": 10.0
          }
        },
        "solver": {
          "eigen": {"eps_tol": 1e-8, "eps_max_it": 200, "ncv": 300}
        }
      }
    }
  },
  "cases": [
    {"case_id": "stationary_m0p6948_A_ncv300",
     "label": "A: stationary ω=(0, -0.6948i), nev=4 ncv=300 tol=1e-8",
     "enabled": true,
     "config_overrides": {
       "analysis": {"omega_target": {"real": 0.0, "imag": -0.6948}}
     }}
  ]
}

{
  // Expose the second mode that ARPACK converged but was dropped in the prior
  // evp_stride4_m4_fd4_fd6_leading run.
  //
  // Goal: capture both ARPACK-converged fd6 modes (nev=1, ncv=40 still converged
  // 2 modes previously). Acceptance is relaxed enough to admit both so we can
  // inspect omega and residuals for the "dropped" second mode.
  //
  // Changes from evp_stride4_m4_fd4_fd6_leading:
  //   - fd4 case disabled (we only need fd6 here)
  //   - n_modes_stability raised to 2 (was 1) so both ARPACK results are retained
  //   - acceptance relaxed generously: target_distance_max 0.25 → 2.0,
  //     omega_real_abs_max 2.0 → 5.0, omega_imag_abs_max 2.5 → 5.0,
  //     postcheck_rel_max 1e-4 → 1.0
  //   - everything else kept identical (omega_target, ncv=40, eps_tol=5e-5,
  //     stride=4, mpi_procs=1)
  "$include": "_defaults.jsonc",
  "outputs": {
    "report_json": "output/evp_stride4_m4_fd6_expose_dropped_mode/case2_evp_stride4_m4_fd6_expose_dropped_mode_latest.json",
    "report_csv": "output/evp_stride4_m4_fd6_expose_dropped_mode/case2_evp_stride4_m4_fd6_expose_dropped_mode_table.csv",
    "log_dir": "output/evp_stride4_m4_fd6_expose_dropped_mode/logs",
    "run_dir": "output/evp_stride4_m4_fd6_expose_dropped_mode/runs"
  },
  "defaults": {
    "launcher": {
      "mpi_procs": 1
    },
    "case_defaults": {
      "config_overrides": {
        "numerics": {
          "stride_ksi": 4,
          "stride_eta": 4
        },
        "analysis": {
          // Raise to 2 so both ARPACK-converged modes are kept and reported.
          "n_modes_stability": 2,
          "omega_target": {
            "real": 0.561107,
            "imag": -1.112186
          },
          "stability_acceptance": {
            // Relaxed generously: we want both modes visible regardless of quality.
            // A tight acceptance is applied in post-processing (not here).
            "postcheck_rel_max": 1.0,         // was 1e-4; now admits any converged mode
            "target_distance_max": 2.0,       // was 0.25; covers a wide region of omega-space
            "omega_real_abs_max": 5.0,        // was 2.0
            "omega_imag_abs_max": 5.0         // was 2.5
          }
        },
        "solver": {
          "eigen": {
            "eps_tol": 5e-05,
            "eps_max_it": 300,
            "ncv": 40
          }
        }
      }
    }
  },
  "cases": [
    {
      // fd4 disabled — only fd6 is needed for this investigation.
      "case_id": "target_branch_m4_fd4_leading",
      "label": "M4 leading target, fd4 [DISABLED]",
      "enabled": false,
      "config_overrides": {
        "numerics": {
          "fd_order": 4
        }
      }
    },
    {
      "case_id": "target_branch_m4_fd6_leading",
      "label": "M4 leading target, fd6",
      "enabled": true,
      "config_overrides": {
        "numerics": {
          "fd_order": 6
        }
      }
    }
  ]
}

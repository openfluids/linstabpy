{
  // Case 2 stability queue pinned to socket 0 physical cores (CPUs 0-9).
  // Run with:
  //   LINSTAB2D_CASE_MODULE=case2 LINSTAB2D_CASE1_PERF_CONFIG=results/case2/perf_memory_cases_stability_socket0.jsonc ../../.venv/bin/python results/case1/perf_memory.py

  "outputs": {
    "report_json": "output/stability_socket0/case2_perf_memory_latest.json",
    "report_csv": "output/stability_socket0/case2_perf_memory_table.csv",
    "log_dir": "output/stability_socket0/logs",
    "run_dir": "output/stability_socket0/runs"
  },

  "defaults": {
    "base_config": "parity_config.jsonc",
    "case_workdir": ".",
    "monitor_interval_seconds": 0.5,
    "python_exe": "../../.venv/bin/python",
    "env": {
      "OMP_NUM_THREADS": "1",
      "OPENBLAS_NUM_THREADS": "1",
      "MKL_NUM_THREADS": "1",
      "NUMEXPR_NUM_THREADS": "1"
    },
    "launcher": {
      "mpi_procs": 10,
      "launcher": "mpiexec --rankfile /home/ghamada/linstabpy/results/case2/socket0.rankfile --bind-to core"
    },
    "case_defaults": {
      "config_overrides": {
        "numerics": {
          "stride_ksi": 1,
          "stride_eta": 1,
          "fd_order": 4,
          "beta": 0.0,
          "alpha_filter": 0.0
        },
        "analysis": {
          "ratio_uinf": 1.0,
          "ratio_l": 0.1,
          "St": 0.1,
          "run_stability": true,
          "run_resolvent": false,
          "n_modes_stability": 50
        },
        "solver": {
          "petsc_matrix_mode": "distributed",
          "eigen": {
            "st_solver": "mumps",
            "eps_tol": 1e-6,
            "ncv": 300,
            "conv_test": "rel",
            "true_residual": true,
            "residual_error_type": "relative"
          },
          "linsolve": {
            "type": "mumps"
          },
          "resolvent": {
            "type": "mumps",
            "eigen": {
              "eps_tol": 1e-8,
              "ncv": 40,
              "conv_test": "rel",
              "true_residual": true,
              "eps_max_it": 1000
            }
          }
        }
      }
    }
  },

  "cases": [
    {
      "case_id": "case2_stability_fd4",
      "label": "Case 2 stability fd4",
      "enabled": true
    },
    {
      "case_id": "case2_stability_fd6",
      "label": "Case 2 stability fd6",
      "enabled": true,
      "config_overrides": {
        "numerics": {
          "fd_order": 6
        }
      }
    },
    {
      "case_id": "case2_stability_fd8",
      "label": "Case 2 stability fd8",
      "enabled": true,
      "config_overrides": {
        "numerics": {
          "fd_order": 8
        }
      }
    }
  ]
}

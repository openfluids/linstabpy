{
  // First resolvent scan on Case 2 — tier-1 paper artefact (PLAN
  // Research-strategy section, 2026-04-18). Resolvent does NOT suffer
  // the shift-invert attractor problem that made EVP target
  // localisation hard (PLAN F6); it takes ω as input and returns a
  // gain curve σ(ω). No EVP needed.
  //
  // Setup:
  //   - Qraw, M2 symmetric (stride_ksi=stride_eta=2)
  //   - γ=1.31 (current parity_config default)
  //   - β=0, fd_order=4, alpha_filter='none'
  //   - MUMPS shifted-solve, SLEPc TRLANCZOS SVD on H^H W H
  //   - n_modes_resolvent=3 per ω (sufficient to see gain separation;
  //     the leading σ₁ is what the paper uses)
  //
  // ω values span the SWBLI low-frequency (Dussauge range ~0.3–0.6)
  // and mid-frequency (our candidate global modes at |Re ω| in
  // {0.39, 1.00, 1.20, 1.60, 1.74}).
  "$include": "_defaults.jsonc",
  "outputs": {
    "report_json": "output/resolvent_m2_qraw_scan/case2_resolvent_m2_qraw_scan_latest.json",
    "report_csv": "output/resolvent_m2_qraw_scan/case2_resolvent_m2_qraw_scan_table.csv",
    "log_dir": "output/resolvent_m2_qraw_scan/logs",
    "run_dir": "output/resolvent_m2_qraw_scan/runs"
  },
  "defaults": {
    "case_defaults": {
      "config_overrides": {
        "numerics": {
          "stride_ksi": 2,
          "stride_eta": 2
        },
        "analysis": {
          "run_stability": false,
          "run_resolvent": true,
          "n_modes_resolvent": 3
        },
        "solver": {
          "resolvent": {
            "type": "mumps",
            "eigen": {
              "eps_tol": 1e-6,
              "ncv": 20,
              "conv_test": "rel",
              "true_residual": true,
              "eps_max_it": 500
            }
          },
          "linsolve": {
            "type": "mumps"
          }
        }
      }
    }
  },
  "cases": [
    {"case_id": "omega_0p20",  "label": "ω=0.20 (St=0.032)", "enabled": true,
     "config_overrides": {"analysis": {"omega_target": {"real": 0.20, "imag": 0.0}}}},
    {"case_id": "omega_0p40",  "label": "ω=0.40 (St=0.064, near global pair 8/9)", "enabled": true,
     "config_overrides": {"analysis": {"omega_target": {"real": 0.40, "imag": 0.0}}}},
    {"case_id": "omega_0p60",  "label": "ω=0.60 (St=0.095, Dussauge upper)", "enabled": true,
     "config_overrides": {"analysis": {"omega_target": {"real": 0.60, "imag": 0.0}}}},
    {"case_id": "omega_1p00",  "label": "ω=1.00 (St=0.159, near global pair 14/15)", "enabled": true,
     "config_overrides": {"analysis": {"omega_target": {"real": 1.00, "imag": 0.0}}}},
    {"case_id": "omega_1p60",  "label": "ω=1.60 (St=0.255, near global pair 10/11)", "enabled": true,
     "config_overrides": {"analysis": {"omega_target": {"real": 1.60, "imag": 0.0}}}},
    {"case_id": "omega_2p00",  "label": "ω=2.00 (St=0.318)", "enabled": true,
     "config_overrides": {"analysis": {"omega_target": {"real": 2.00, "imag": 0.0}}}},
    {"case_id": "omega_3p00",  "label": "ω=3.00 (St=0.477)", "enabled": true,
     "config_overrides": {"analysis": {"omega_target": {"real": 3.00, "imag": 0.0}}}}
  ]
}

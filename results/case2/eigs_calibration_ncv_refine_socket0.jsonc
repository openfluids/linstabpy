{
  // Case 2 stability ncv refinement at fixed eps_tol=1e-4.
  // This fills the gaps between the existing ncv sweep points so the
  // saturation curve is easier to read.

  "outputs": {
    "report_json": "output/eigs_calibration_ncv_refine_socket0/case2_eigs_calibration_ncv_refine_latest.json",
    "report_csv": "output/eigs_calibration_ncv_refine_socket0/case2_eigs_calibration_ncv_refine_table.csv",
    "log_dir": "output/eigs_calibration_ncv_refine_socket0/logs",
    "run_dir": "output/eigs_calibration_ncv_refine_socket0/runs"
  },

  "defaults": {
    "base_config": "parity_config.jsonc",
    "case_workdir": ".",
    "monitor_interval_seconds": 0.5,
    "python_exe": "../../.venv/bin/python",
    "env": {
      "OMP_NUM_THREADS": "1",
      "OPENBLAS_NUM_THREADS": "1",
      "MKL_NUM_THREADS": "1",
      "NUMEXPR_NUM_THREADS": "1"
    },
    "launcher": {
      "mpi_procs": 10,
      "launcher": "mpiexec --rankfile /home/ghamada/linstabpy/results/case2/socket0.rankfile --bind-to core"
    },
    "case_defaults": {
      "config_overrides": {
        "numerics": {
          "stride_ksi": 1,
          "stride_eta": 1,
          "fd_order": 4,
          "beta": 0.0,
          "alpha_filter": 0.0
        },
        "analysis": {
          "ratio_uinf": 1.0,
          "ratio_l": 0.1,
          "St": 0.1,
          "run_stability": true,
          "run_resolvent": false,
          "n_modes_stability": 10
        },
        "solver": {
          "petsc_matrix_mode": "distributed",
          "eigen": {
            "st_solver": "mumps",
            "eps_tol": 1e-4,
            "conv_test": "rel",
            "true_residual": true,
            "residual_error_type": "relative",
            "extract_all_converged": true,
            "monitor": true,
            "monitor_every": 10,
            "eps_max_it": 1000
          },
          "linsolve": {
            "type": "mumps"
          },
          "resolvent": {
            "type": "mumps",
            "eigen": {
              "eps_tol": 1e-8,
              "ncv": 40,
              "conv_test": "rel",
              "true_residual": true,
              "eps_max_it": 1000
            }
          }
        }
      }
    }
  },

  "cases": [
    {
      "case_id": "fd4_nev10_tol1e4_ncv400",
      "label": "fd4 nev10 tol1e-4 ncv400",
      "enabled": true,
      "config_overrides": {
        "solver": {
          "eigen": {
            "ncv": 400
          }
        }
      }
    },
    {
      "case_id": "fd4_nev10_tol1e4_ncv600",
      "label": "fd4 nev10 tol1e-4 ncv600",
      "enabled": true,
      "config_overrides": {
        "solver": {
          "eigen": {
            "ncv": 600
          }
        }
      }
    },
    {
      "case_id": "fd4_nev10_tol1e4_ncv800",
      "label": "fd4 nev10 tol1e-4 ncv800",
      "enabled": true,
      "config_overrides": {
        "solver": {
          "eigen": {
            "ncv": 800
          }
        }
      }
    }
  ]
}

{
  // Case 1 stability study pinned to socket 0 physical cores only.
  //
  // Run with:
  //   LINSTAB2D_CASE1_PERF_CONFIG=results/case1/perf_memory_cases_stability_socket0.jsonc ../../.venv/bin/python results/case1/perf_memory.py

  "outputs": {
    "report_json": "output/stability_socket0/case1_perf_memory_latest.json",
    "report_csv": "output/stability_socket0/case1_perf_memory_table.csv",
    "log_dir": "output/stability_socket0/logs",
    "run_dir": "output/stability_socket0/runs"
  },

  "defaults": {
    "base_config": "parity_config.jsonc",
    "monitor_interval_seconds": 0.5,
    "python_exe": "../../.venv/bin/python",
    "env": {
      "OMP_NUM_THREADS": "1",
      "OPENBLAS_NUM_THREADS": "1",
      "MKL_NUM_THREADS": "1",
      "NUMEXPR_NUM_THREADS": "1"
    },
    "launcher": {
      "mpi_procs": 10,
      "launcher": "mpiexec --cpu-set 0-9 --bind-to core"
    },
    "case_defaults": {
      "config_overrides": {
        "numerics": {
          "stride_ksi": 1,
          "stride_eta": 1,
          "fd_order": 4,
          "beta": 0.0,
          "alpha_filter": 0.0
        },
        "analysis": {
          "ratio_uinf": 1.0,
          "ratio_l": 0.1,
          "St": 0.1,
          "use_raw_eigs": false,
          "run_stability": true,
          "run_resolvent": false,
          "n_modes_stability": 200
        },
        "physics": {
          "use_matlab_sponge_aux": false,
          "sponge": {
            "enabled": true,
            "preset": "case1_smooth_half"
          }
        },
        "solver": {
          "petsc_matrix_mode": "distributed",
          "eigen": {
            "st_solver": "mumps",
            "eps_tol": 1e-6,
            "ncv": 460,
            "conv_test": "rel",
            "true_residual": true
          },
          "linsolve": {
            "type": "mumps"
          },
          "resolvent": {
            "type": "mumps",
            "eigen": {
              "eps_tol": 1e-8,
              "ncv": 40,
              "conv_test": "rel",
              "true_residual": true,
              "eps_max_it": 1000
            }
          }
        }
      }
    }
  },

  "cases": [
    {
      "case_id": "case1_stability_fd4_sponge_sigma_0p5",
      "label": "Case 1 stability fd4, sponge sigma_max=0.5",
      "enabled": true
    },
    {
      "case_id": "case1_stability_fd6_sponge_sigma_0p5",
      "label": "Case 1 stability fd6, sponge sigma_max=0.5",
      "enabled": true,
      "config_overrides": {
        "numerics": {
          "fd_order": 6
        }
      }
    },
    {
      "case_id": "case1_stability_fd8_sponge_sigma_0p5",
      "label": "Case 1 stability fd8, sponge sigma_max=0.5",
      "enabled": true,
      "config_overrides": {
        "numerics": {
          "fd_order": 8
        }
      }
    }
  ]
}

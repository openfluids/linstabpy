{
  // Case 1 sponge-magnitude sensitivity at matched fd4 settings.
  //
  // Run with:
  //   LINSTAB2D_CASE1_PERF_CONFIG=results/case1/perf_memory_cases_sponge_sigma.jsonc ../../.venv/bin/python results/case1/perf_memory.py
  //
  // Purpose:
  // - isolate the effect of sponge magnitude alone
  // - keep geometry/profile fixed
  // - vary only sigma_max in the smooth localized corner sponge

  "outputs": {
    "report_json": "output/sponge_sigma/case1_perf_memory_latest.json",
    "report_csv": "output/sponge_sigma/case1_perf_memory_table.csv",
    "log_dir": "output/sponge_sigma/logs",
    "run_dir": "output/sponge_sigma/runs"
  },

  "defaults": {
    "base_config": "parity_config.jsonc",
    "monitor_interval_seconds": 0.5,
    "python_exe": "../../.venv/bin/python",
    "env": {
      "OMP_NUM_THREADS": "1",
      "OPENBLAS_NUM_THREADS": "1",
      "MKL_NUM_THREADS": "1",
      "NUMEXPR_NUM_THREADS": "1"
    },
    "launcher": {
      "mpi_procs": 10,
      "launcher": "mpiexec"
    },
    "case_defaults": {
      "config_overrides": {
        "numerics": {
          "stride_ksi": 1,
          "stride_eta": 1,
          "fd_order": 4,
          "beta": 0.0,
          "alpha_filter": 0.0
        },
        "analysis": {
          "ratio_uinf": 1.0,
          "ratio_l": 0.1,
          "St": 0.1,
          "use_raw_eigs": false,
          "run_stability": true,
          "run_resolvent": false,
          "n_modes_stability": 300
        },
        "physics": {
          "use_matlab_sponge_aux": false,
          "sponge": {
            "enabled": true,
            "preset": "case1_smooth_unit"
          }
        },
        "solver": {
          "petsc_matrix_mode": "distributed",
          "eigen": {
            "st_solver": "mumps",
            "eps_tol": 1e-12,
            "ncv": 700
          },
          "linsolve": {
            "type": "mumps"
          }
        }
      }
    }
  },

  "cases": [
    {
      "case_id": "case1_fd4_sponge_sigma_0p25",
      "label": "Case 1 fd4 sponge sigma_max=0.25",
      "enabled": true,
      "config_overrides": {
        "physics": {
          "sponge": {
            "preset": "case1_smooth_quarter"
          }
        }
      }
    },
    {
      "case_id": "case1_fd4_sponge_sigma_0p5",
      "label": "Case 1 fd4 sponge sigma_max=0.5",
      "enabled": true,
      "config_overrides": {
        "physics": {
          "sponge": {
            "preset": "case1_smooth_half"
          }
        }
      }
    },
    {
      "case_id": "case1_fd4_sponge_sigma_1p0",
      "label": "Case 1 fd4 sponge sigma_max=1.0",
      "enabled": true,
      "config_overrides": {
        "physics": {
          "sponge": {
            "preset": "case1_smooth_unit"
          }
        }
      }
    },
    {
      "case_id": "case1_fd4_sponge_sigma_2p0",
      "label": "Case 1 fd4 sponge sigma_max=2.0",
      "enabled": true,
      "config_overrides": {
        "physics": {
          "sponge": {
            "preset": "case1_smooth_double"
          }
        }
      }
    }
  ]
}

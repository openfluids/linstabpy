{
  // Canonical parity configuration for Case 1 (SWBLI).
  // Runtime code should use this as default and only diverge when
  // explicit environment overrides are provided.
  // Paths are relative to results/case1/ (the directory containing this file).

  "paths": {
    // Directory containing x/y/rho/u/v/w/T/sponge .npy files (same dir as this config).
    "case_dir": ".",

    // MATLAB exports used for matrix/spectrum parity validation.
    "matlab_exports_stability_dir": "MATLAB_exports",
    "matlab_exports_resolvent_dir": "MATLAB_exports_resolvent",
    "matlab_exports_operator_stage_dir": "MATLAB_exports_resolvent",

    // Optional MATLAB case-input dump used only by parity/HDF5 tooling.
    "case_inputs_mat": "MATLAB_exports_resolvent/case_inputs_used.mat"
  },

  "physics": {
    "Re": 395000.0,
    "Ma": 2.0,
    "Pr": 0.747,

    // IMPORTANT:
    // `run_metadata.mat` reports 1.31, but exported operator/spectrum
    // parity aligns with baseFlow.kappa = 1.4.
    "kappa": 1.4,

    "T_0": 1540.0,

    // Keep off for strict parity with this dataset.
    "zero_spanwise": false,

    // Default to the native resolvent preset so normal Case 1 runs do not
    // depend on HDF5 / h5py.
    "use_matlab_sponge_aux": false,
    "sponge": {
      "enabled": true,
      "preset": "case1_resolvent"
    },

    // MATLAB exported fields consumed by GetLinProblem use zero dMUdT terms.
    "zero_mu_t_derivs": true
  },

  "numerics": {
    "stride_ksi": 1,
    "stride_eta": 1,
    "fd_order": 4,
    "beta": 0.0,

    // MATLAB convention: alpha_filter = 0.0 means active explicit filter.
    // "none" disables filtering.
    "alpha_filter": 0.0
  },

  "bc": {
    "penalty": 100000000.0,
    "recipe": [
      {"type": "dirichlet", "borders": "lt",  "variables": "ruvwT"},
      {"type": "dirichlet", "borders": "b",   "variables": "ruvw"},
      {"type": "neumann",   "borders": "b",   "variables": "T"},
      {"type": "neumann",   "borders": "r",   "variables": "ruvwT"}
    ]
  },

  "analysis": {
    "ratio_uinf": 1.0,
    "ratio_l": 0.1,
    "St": 0.1,

    "n_modes_stability": 100,
    "n_modes_resolvent": 10,

    "run_stability": true,
    "run_resolvent": true,

    // MATLAB parity path uses temporal eigs on i*L0.
    "use_raw_eigs": false
  },

  "parity_tolerances": {
    "operator_stage_max_rel": 1e-8,
    "operator_stage_max_abs_early": 1e-3,
    "spectrum_max_rel": 1e-6,
    "mode_min_corr_real": 0.99
  },

  // Solver configuration
  // Replaces LINSTAB2D_* env vars previously set in case1.sh.
  "solver": {
    // PETSc matrix transfer: "auto" (default), "local", "distributed"
    "petsc_matrix_mode": "auto",

    // Eigenvalue solver (temporal, adjoint, spatial)
    "eigen": {
      // Spectral transformation backend:
      //   "mumps"     -> direct shift-invert, with KSP=PREONLY and PC=LU
      //   "iterative" -> Krylov linear solve inside ST
      //
      // In the direct-MUMPS path, the meaningful tuning knobs are EPS-level
      // settings such as eps_tol / conv_test / true_residual / ncv, not KSP
      // Krylov tolerances.
      "st_solver": "mumps",

      // EPS convergence threshold (not the same as explicit postchecked
      // full-operator residual).
      "eps_tol": 1e-6,

      // Krylov subspace size for EPS. This is often a quality knob, not just
      // a performance knob, for interior non-normal problems.
      "ncv": 300,

      // EPS convergence test:
      //   "rel" = relative to eigenvalue magnitude
      //   "abs" = absolute
      //   "norm" = matrix-norm-based
      "conv_test": "rel",

      // With shift-invert, true residuals are safer than cheap transformed
      // residual estimates, at some extra cost.
      "true_residual": true
    },

    // Linear solver (resolvent factorization)
    "linsolve": {
      // Shifted linear solve used inside each resolvent shell application:
      //   "mumps"     -> direct KSPPREONLY + PCLU + MUMPS
      //   "iterative" -> Krylov linear solve with meaningful KSP tolerances
      "type": "mumps"
    },

    // EPS settings for the H^H W H shell eigenproblem used to extract
    // resolvent gains and forcing/response modes.
    "resolvent": {
      "type": "mumps",
      "eigen": {
        // EPS convergence threshold on the shell-operator eigenproblem.
        "eps_tol": 1e-8,

        // Krylov subspace size for the shell-operator EPS solve. Increase this
        // when singular values/modes are not saturating cleanly.
        "ncv": 40,

        // EPS convergence test on the shell-operator eigenproblem.
        "conv_test": "rel",

        // With shell operators and transformed residual estimates, true
        // residuals are safer at some extra cost.
        "true_residual": true,

        // Maximum EPS iterations on H^H W H.
        "eps_max_it": 1000
      }
    }
  }
}

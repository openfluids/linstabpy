{
  // Case 1efficiency harness cases.
  // Enable one or more entries below, then run:
  //   ./.venv/bin/python tools/parity/perf_memory.py
  //
  // Each case launches the canonical case1.compute() pipeline in a
  // child process, monitors wall time and peak process-tree RSS, parses nnz
  // from the real log stream, and stores a copy of case1.npz.

  "outputs": {
    "report_json": "output/case1_perf_memory_latest.json",
    "report_csv": "output/case1_perf_memory_table.csv",
    "log_dir": "output/logs",
    "run_dir": "output/runs"
  },

  "defaults": {
    // Sampling interval for process-tree RSS monitoring.
    "monitor_interval_seconds": 0.5,

    // Python executable used to launch the child run.
    "python_exe": "./.venv/bin/python",

    // Baseline environment for all cases. Override per case only when needed.
    "env": {
      "LINSTAB2D_CASE1_CONFIG": "case1/parity_config.jsonc",
      "LINSTAB2D_CASE1_CASE_DIR": "case1",
      "LINSTAB2D_CASE1_CASE_INPUTS_MAT": "case1/MATLAB_exports_resolvent/case_inputs_used.mat",
      "LINSTAB2D_CASE1_ZERO_MU_T_DERIVS": "1",
      "LINSTAB2D_CASE1_USE_MATLAB_SPONGE_AUX": "1",
      "LINSTAB2D_CASE1_ALPHA_FILTER": "0.0",

      // Default robust direct-solver baseline.
      "LINSTAB2D_EIGEN_ST_SOLVER": "mumps",
      "LINSTAB2D_RESOLVENT_TYPE": "mumps"
    },

    // Launcher defaults. For MPI runs, set e.g. launcher="mpiexec" and
    // mpi_procs>1 in the case entry.
    "launcher": {
      "mpi_procs": 1,
      "launcher": ""
    }
  },

  "cases": [
    {
      "case_id": "case1_stability_stride_12",
      "label": "Case 1stability, reduced grid for local verification",
      "enabled": true,
      "stride_ksi": 12,
      "stride_eta": 12,
      "run_stability": true,
      "run_resolvent": false,
      "n_modes_stability": 10
    },
    {
      "case_id": "case1_resolvent_stride_12",
      "label": "Case 1resolvent, reduced grid for local verification",
      "enabled": false,
      "stride_ksi": 12,
      "stride_eta": 12,
      "run_stability": false,
      "run_resolvent": true,
      "n_modes_resolvent": 3
    },
    {
      "case_id": "case1_stability_stride_1",
      "label": "Case 1full-grid stability baseline",
      "enabled": false,
      "stride_ksi": 1,
      "stride_eta": 1,
      "run_stability": true,
      "run_resolvent": false,
      "n_modes_stability": 30
    },
    {
      "case_id": "case1_resolvent_stride_1",
      "label": "Case 1full-grid resolvent baseline",
      "enabled": false,
      "stride_ksi": 1,
      "stride_eta": 1,
      "run_stability": false,
      "run_resolvent": true,
      "n_modes_resolvent": 5
    },
    {
      "case_id": "case1_stability_stride_1_iterative",
      "label": "Case 1full-grid stability with iterative ST solve",
      "enabled": false,
      "stride_ksi": 1,
      "stride_eta": 1,
      "run_stability": true,
      "run_resolvent": false,
      "n_modes_stability": 30,
      "env": {
        "LINSTAB2D_EIGEN_ST_SOLVER": "iterative",
        "LINSTAB2D_EIGEN_KSP_TYPE": "fgmres",
        "LINSTAB2D_EIGEN_PC_TYPE": "asm"
      }
    }
  ]
}

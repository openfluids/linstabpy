{
  // Follow-up to evp_m2_qraw_tight_certify.jsonc: certify the ONE
  // actual GLOBAL-classified eigenmode in the M2 Qraw spectrum. The
  // previous tight-certify configs targeted (0.235, -7.13i) and
  // (0.333, -7.27i), which are resolvent scan ω positions, NOT
  // eigenvalues. They got copied into the paper by mistake. The
  // classifier CSV puts the single GLOBAL pair at ω=(±1.7416, -6.317i),
  // with global_extent=21.5%, wall_frac=2%. St=0.277 (NOT in Dussauge
  // range).
  //
  // Certify the positive-Re side. Same tight settings as the main
  // tight-certify config.
  "$include": "_defaults.jsonc",
  "outputs": {
    "report_json": "output/evp_m2_qraw_tight_certify_globalmode/case2_evp_m2_qraw_tight_certify_globalmode_latest.json",
    "report_csv": "output/evp_m2_qraw_tight_certify_globalmode/case2_evp_m2_qraw_tight_certify_globalmode_table.csv",
    "log_dir": "output/evp_m2_qraw_tight_certify_globalmode/logs",
    "run_dir": "output/evp_m2_qraw_tight_certify_globalmode/runs"
  },
  "defaults": {
    "case_defaults": {
      "config_overrides": {
        "numerics": {"stride_ksi": 2, "stride_eta": 2},
        "analysis": {
          "n_modes_stability": 4,
          "stability_acceptance": {
            "postcheck_rel_max": 1e-6,
            "target_distance_max": 0.3,
            "omega_real_abs_max": 5.0,
            "omega_imag_abs_max": 10.0
          }
        },
        "solver": {
          "eigen": {"eps_tol": 1e-8, "eps_max_it": 1000, "ncv": 80}
        }
      }
    }
  },
  "cases": [
    {"case_id": "global_1p7416_m6p317",
     "label": "GLOBAL M2 Qraw mode: ω=(+1.7416, -6.317i), St=0.277",
     "enabled": true,
     "config_overrides": {
       "analysis": {"omega_target": {"real": 1.7416, "imag": -6.317}}
     }}
  ]
}

{
  // Compare fd6 leading-mode extraction between PETSc matrix modes.
  //
  // If distributed vs local changes the returned mode materially under the
  // same target/mesh/order, the suspect moves from "physics / branch
  // sensitivity" toward the assembly/solve path.
  "$include": "_defaults.jsonc",
  "outputs": {
    "report_json": "output/evp_stride4_m4_fd6_matrixmode_leading/case2_evp_stride4_m4_fd6_matrixmode_leading_latest.json",
    "report_csv": "output/evp_stride4_m4_fd6_matrixmode_leading/case2_evp_stride4_m4_fd6_matrixmode_leading_table.csv",
    "log_dir": "output/evp_stride4_m4_fd6_matrixmode_leading/logs",
    "run_dir": "output/evp_stride4_m4_fd6_matrixmode_leading/runs"
  },
  "defaults": {
    "launcher": {
      "mpi_procs": 1
    },
    "case_defaults": {
      "config_overrides": {
        "numerics": {
          "stride_ksi": 4,
          "stride_eta": 4,
          "fd_order": 6
        },
        "analysis": {
          "n_modes_stability": 1,
          "omega_target": {
            "real": 0.561107,
            "imag": -1.112186
          },
          "stability_acceptance": {
            "postcheck_rel_max": 1e-04,
            "target_distance_max": 0.25,
            "omega_real_abs_max": 2.0,
            "omega_imag_abs_max": 2.5
          }
        },
        "solver": {
          "eigen": {
            "eps_tol": 5e-05,
            "eps_max_it": 300,
            "ncv": 40
          }
        }
      }
    }
  },
  "cases": [
    {
      "case_id": "target_branch_m4_fd6_distributed",
      "label": "M4 fd6 leading, distributed matrix",
      "enabled": true,
      "config_overrides": {
        "solver": {
          "petsc_matrix_mode": "distributed"
        }
      }
    },
    {
      "case_id": "target_branch_m4_fd6_local",
      "label": "M4 fd6 leading, local matrix",
      "enabled": true,
      "config_overrides": {
        "solver": {
          "petsc_matrix_mode": "local"
        }
      }
    }
  ]
}

{
  // Sweet-spot sweep B (2026-04-20). Config A (ncv=300, tol=1e-8)
  // ran 200 iters without converging; err_max plateaued 1.3–3.4.
  // Bigger ncv alone is not the fix.
  //
  // Hypothesis B: the eigenvalue at (0, -0.6948i) is real but the
  // surrounding wall-local cluster is too dense to resolve at 1e-8
  // at this problem size; an intermediate tolerance 1e-5 (still
  // 3 orders tighter than screening's 5e-3) is a defensible
  // certificate. If B converges, we publish 5-digit certification;
  // if B stagnates, the pathology is structural.
  //
  // Fast: ncv=80 (screening-size subspace), tol=1e-5, max_it=100.
  // Expected wall time ~5 min.
  "$include": "_defaults.jsonc",
  "outputs": {
    "report_json": "output/evp_m2_qraw_sweet_B_tol1em5/case2_evp_m2_qraw_sweet_B_tol1em5_latest.json",
    "report_csv":  "output/evp_m2_qraw_sweet_B_tol1em5/case2_evp_m2_qraw_sweet_B_tol1em5_table.csv",
    "log_dir":     "output/evp_m2_qraw_sweet_B_tol1em5/logs",
    "run_dir":     "output/evp_m2_qraw_sweet_B_tol1em5/runs"
  },
  "defaults": {
    "case_defaults": {
      "config_overrides": {
        "numerics": {"stride_ksi": 2, "stride_eta": 2},
        "analysis": {
          "n_modes_stability": 4,
          "stability_acceptance": {
            "postcheck_rel_max": 1e-4,
            "target_distance_max": 0.3,
            "omega_real_abs_max": 5.0,
            "omega_imag_abs_max": 10.0
          }
        },
        "solver": {
          "eigen": {"eps_tol": 1e-5, "eps_max_it": 100, "ncv": 80}
        }
      }
    }
  },
  "cases": [
    {"case_id": "stationary_m0p6948_B_tol1em5",
     "label": "B: stationary ω=(0, -0.6948i), nev=4 ncv=80 tol=1e-5",
     "enabled": true,
     "config_overrides": {
       "analysis": {"omega_target": {"real": 0.0, "imag": -0.6948}}
     }}
  ]
}

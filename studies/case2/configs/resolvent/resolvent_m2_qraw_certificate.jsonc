{
  // Convergence certificate run (2026-04-20). Same ω=0.40 as the scan
  // and the tight-check, but with the NEW pipeline that calls
  // compute_resolvent_svd_residuals() post-solve. Produces rho_fwd and
  // rho_adj per mode so that σ₁ convergence can be proven from the NPZ
  // alone, without trusting SLEPc's internal flag.
  //
  // rho_fwd ≈ machine eps by construction (u_i = H v_i / σ_i).
  // rho_adj is the primary quality signal; converged solves hit
  // rho_adj ≤ SLEPc tol (1e-8 here).
  "$include": "../_defaults.jsonc",
  "outputs": {
    "report_json": "output/resolvent_m2_qraw_certificate/case2_resolvent_m2_qraw_certificate_latest.json",
    "report_csv": "output/resolvent_m2_qraw_certificate/case2_resolvent_m2_qraw_certificate_table.csv",
    "log_dir": "output/resolvent_m2_qraw_certificate/logs",
    "run_dir": "output/resolvent_m2_qraw_certificate/runs"
  },
  "defaults": {
    "case_defaults": {
      "config_overrides": {
        "numerics": {"stride_ksi": 2, "stride_eta": 2},
        "analysis": {
          "run_stability": false,
          "run_resolvent": true,
          "n_modes_resolvent": 6
        },
        "solver": {
          "resolvent": {
            "type": "mumps",
            "eigen": {
              "eps_tol": 1e-8,
              "ncv": 40,
              "conv_test": "rel",
              "true_residual": true,
              "eps_max_it": 1000
            }
          },
          "linsolve": {"type": "mumps"}
        }
      }
    }
  },
  "cases": [
    {"case_id": "cert_omega_0p40", "label": "ω=0.40 convergence certificate",
     "enabled": true,
     "config_overrides": {"analysis": {"omega_target": {"real": 0.40, "imag": 0.0}}}}
  ]
}

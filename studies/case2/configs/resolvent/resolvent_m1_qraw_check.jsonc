{
  // M1 resolvent cross-mesh check. Run at ω=0.4 (a point where M2
  // gave σ₁=16.259). If M1 σ₁ matches within a few percent, the
  // broadband-amplifier story is mesh-independent (T2 paper claim).
  // If not, the paper needs a mesh-convergence caveat.
  "$include": "../_defaults.jsonc",
  "outputs": {
    "report_json": "output/resolvent_m1_qraw_check/case2_resolvent_m1_qraw_check_latest.json",
    "report_csv": "output/resolvent_m1_qraw_check/case2_resolvent_m1_qraw_check_table.csv",
    "log_dir": "output/resolvent_m1_qraw_check/logs",
    "run_dir": "output/resolvent_m1_qraw_check/runs"
  },
  "defaults": {
    "case_defaults": {
      "config_overrides": {
        "numerics": {"stride_ksi": 1, "stride_eta": 1},
        "analysis": {
          "run_stability": false, "run_resolvent": true,
          "n_modes_resolvent": 3
        },
        "solver": {
          "resolvent": {
            "type": "mumps",
            "eigen": {"eps_tol": 1e-6, "ncv": 20, "conv_test": "rel",
                       "true_residual": true, "eps_max_it": 500}
          },
          "linsolve": {"type": "mumps"}
        }
      }
    }
  },
  "cases": [
    {"case_id": "omega_0p40_m1",
     "label": "M1 resolvent at ω=0.40 (cross-mesh check)",
     "enabled": true,
     "config_overrides": {"analysis": {"omega_target": {"real": 0.40, "imag": 0.0}}}}
  ]
}

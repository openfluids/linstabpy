// Phase 3: Case 2 resolvent gain map at fd6 stride-4.
//
// 50 cases spanning (beta, St) for paper section 6 (Lui resolvent).
// Generated by studies/case2/scripts/gen_resolvent_grid_50pt.py;
// regenerate via that script after any grid change. Do not
// hand-edit (changes will be lost on next regen).
//
// 50 cases (8x7 - 6 dropped).
// Dropped (beta, St): [(8.0, 5.0), (12.0, 5.0), (16.0, 2.0), (16.0, 5.0), (24.0, 2.0), (24.0, 5.0)]
//
// Per-point overrides: numerics.beta, analysis.omega_target.real
// (omega = 2*pi*St). All other knobs inherit from _defaults.jsonc
// (parity_config -> _defaults -> this file).
//
// Tracked by bead resolvent-gzn (Phase 3 setup) and resolvent-25o
// (Phase 3 launch). Expected wall ~47 h serial; ~15 GiB peak RSS per
// point at fd6 stride-4 distributed-10 ranks.

{
  "$include": "../_defaults.jsonc",
  "outputs": {
    "report_json": "output/resolvent_grid_50pt_fd6_stride4/report_latest.json",
    "report_csv": "output/resolvent_grid_50pt_fd6_stride4/report_table.csv",
    "log_dir": "output/resolvent_grid_50pt_fd6_stride4/logs",
    "run_dir": "output/resolvent_grid_50pt_fd6_stride4/runs"
  },
  "defaults": {
    "launcher": {
      "mpi_procs": 10,
      "launcher": "mpiexec --rankfile /home/ghamada/linstabpy/studies/case2/socket1.rankfile --bind-to core"
    },
    "case_defaults": {
      "config_overrides": {
        "numerics": {
          "stride_ksi": 4,
          "stride_eta": 4,
          "fd_order": 6,
          "alpha_filter": "none",
          "operator_dissipation": {
            "enabled": true,
            "epsilon": 1.0,
            "apply_to_resolvent": true
          }
        },
        "analysis": {
          "run_stability": false,
          "run_resolvent": true,
          "n_modes_resolvent": 3
        },
        "solver": {
          "petsc_matrix_mode": "distributed",
          "resolvent": {
            "type": "mumps",
            "eigen": {
              "eps_tol": 1e-06,
              "ncv": 20,
              "conv_test": "rel",
              "true_residual": true,
              "eps_max_it": 500
            }
          },
          "linsolve": {
            "type": "mumps"
          }
        }
      }
    }
  },
  "cases": [

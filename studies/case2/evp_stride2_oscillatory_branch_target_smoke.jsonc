{
  "$include": "_defaults.jsonc",
  "outputs": {
    "report_json": "output/evp_stride2_oscillatory_branch_target_smoke/case2_evp_stride2_oscillatory_branch_target_smoke_latest.json",
    "report_csv": "output/evp_stride2_oscillatory_branch_target_smoke/case2_evp_stride2_oscillatory_branch_target_smoke_table.csv",
    "log_dir": "output/evp_stride2_oscillatory_branch_target_smoke/logs",
    "run_dir": "output/evp_stride2_oscillatory_branch_target_smoke/runs"
  },
  "defaults": {
    "case_defaults": {
      "config_overrides": {
        "numerics": {
          "stride_ksi": 2,
          "stride_eta": 2
        },
        "analysis": {
          "n_modes_stability": 2,
          "stability_acceptance": {
            "postcheck_rel_max": 5e-05,
            "target_distance_max": 0.25,
            "omega_real_abs_max": 1.5,
            "omega_imag_abs_max": 2.0
          }
        },
        "solver": {
          "eigen": {
            "eps_tol": 1e-05,
            "eps_max_it": 300,
            "ncv": 80
          }
        }
      }
    }
  },
  "cases": [
    {
      "case_id": "target_branch_0p45_m1p00_smoke",
      "label": "stride2 branch smoke target 0.45-1.00i",
      "enabled": true,
      "config_overrides": {
        "analysis": {
          "omega_target": {
            "real": 0.45,
            "imag": -1.0
          }
        }
      }
    },
    {
      "case_id": "target_branch_0p55_m1p10_smoke",
      "label": "stride2 branch smoke target 0.55-1.10i",
      "enabled": true,
      "config_overrides": {
        "analysis": {
          "omega_target": {
            "real": 0.55,
            "imag": -1.1
          }
        }
      }
    },
    {
      "case_id": "target_branch_0p561107_m1p112186_smoke",
      "label": "stride2 branch smoke target 0.561107-1.112186i",
      "enabled": true,
      "config_overrides": {
        "analysis": {
          "omega_target": {
            "real": 0.561107,
            "imag": -1.112186
          }
        }
      }
    },
    {
      "case_id": "target_branch_0p65_m1p20_smoke",
      "label": "stride2 branch smoke target 0.65-1.20i",
      "enabled": true,
      "config_overrides": {
        "analysis": {
          "omega_target": {
            "real": 0.65,
            "imag": -1.2
          }
        }
      }
    }
  ]
}

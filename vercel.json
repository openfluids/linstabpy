{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "uv sync --only-group wiki",
  "buildCommand": "python3 tools/generate_wiki_boundaries.py && python3 tools/generate_llms_full.py && uv run --only-group wiki mkdocs build --strict",
  "outputDirectory": "site",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Link", "value": "</llms.txt>; rel=\"describedby\"" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}

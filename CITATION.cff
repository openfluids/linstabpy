cff-version: 1.2.0
title: linstabpy
message: >-
  If you use linstabpy in published work, please cite the LinStabPy
  paper (Hamada et al., under revision) as the preferred citation,
  together with the LinStab2D methodology paper (Martini & Schmidt
  2024) listed under references.
type: software
authors:
  - given-names: Gabriel Y. R.
    family-names: Hamada
  - given-names: William R.
    family-names: Wolf
  - given-names: Carlos
    family-names: Junqueira-Junior
  - given-names: Jean-Christophe
    family-names: Robinet
  - given-names: Ricardo A. S.
    family-names: Frantz
repository-code: 'https://github.com/openfluids/linstabpy'
url: 'https://github.com/openfluids/linstabpy'
license: GPL-3.0-only
# TODO when the first tagged release lands on Zenodo, add the
# following three keys with concrete values (placeholders below
# are deliberately omitted because strict CFF validation rejects
# non-ISO-8601 date-released or invalid DOI strings):
#   doi: 10.5281/zenodo.XXXXXXX
#   version: v0.1.0
#   date-released: 2026-MM-DD
preferred-citation:
  type: article
  title: >-
    LinStabPy: an efficient Python framework for compressible
    stability and resolvent analysis
  authors:
    - given-names: Gabriel Y. R.
      family-names: Hamada
    - given-names: William R.
      family-names: Wolf
    - given-names: Carlos
      family-names: Junqueira-Junior
    - given-names: Jean-Christophe
      family-names: Robinet
    - given-names: Ricardo A. S.
      family-names: Frantz
  journal: Theoretical and Computational Fluid Dynamics
  year: 2026
  notes: Under revision.
references:
  - type: article
    title: >-
      LinStab2D: stability and resolvent analysis of compressible
      viscous flows in MATLAB
    authors:
      - given-names: Eduardo
        family-names: Martini
      - given-names: Oliver T.
        family-names: Schmidt
    journal: Theoretical and Computational Fluid Dynamics
    year: 2024
    volume: 38
    issue: 5
    start: 665
    end: 685
    doi: 10.1007/s00162-024-00706-0

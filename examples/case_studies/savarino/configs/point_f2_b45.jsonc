// Savarino point (conservative-momentum forcing space) beta=45.0 f=2 -- the
// medium-frequency first-Mack point used by verify_norm_convention.py and
// compare_modes.py.
{
  "paths": {
    // Point this at the directory written by savarino_to_npy.py.
    "case_dir": "data/converted"
  },
  "physics": {
    "Re": 100000.0,
    "Ma": 2.15,
    "Pr": 0.72,
    "kappa": 1.4,
    "T_0": 156.92,
    "zero_spanwise": false,
    "zero_mu_t_derivs": false,
    "use_matlab_sponge_aux": false,
    "sponge": {
      "enabled": false
    }
  },
  "numerics": {
    "stride_ksi": 1,
    "stride_eta": 1,
    "fd_order": 4,
    "beta": 45.0,
    "alpha_filter": 0.0,
    "operator_dissipation": {
      "enabled": false,
      "epsilon": 0.0,
      "apply_to_stability": true,
      "apply_to_resolvent": true
    }
  },
  "bc": {
    "penalty": 100000000.0,
    "recipe": [
      {
        "type": "dirichlet",
        "borders": "lt",
        "variables": "ruvwT"
      },
      {
        "type": "dirichlet",
        "borders": "b",
        "variables": "ruvw"
      },
      {
        "type": "neumann",
        "borders": "b",
        "variables": "T"
      },
      {
        "type": "neumann",
        "borders": "r",
        "variables": "ruvwT"
      }
    ]
  },
  "analysis": {
    "ratio_uinf": 1.0,
    "ratio_l": 0.1,
    "St": 0.1,
    "run_stability": false,
    "run_resolvent": true,
    "use_raw_eigs": false,
    "n_modes_stability": 20,
    "n_modes_resolvent": 1,
    "skip_band_marking": true,
    "omega_target": {
      "real": 12.566370614359172,
      "imag": 0.0
    }
  },
  "solver": {
    "petsc_matrix_mode": "distributed",
    "factor_backend": "mumps",
    "eigen": {
      "st_solver": "mumps",
      "eps_tol": 1e-06,
      "ncv": 160,
      "conv_test": "rel",
      "true_residual": false
    },
    "linsolve": {
      "type": "mumps"
    },
    "resolvent": {
      "type": "mumps",
      "eigen": {
        "forcing_norm": "l2"
      }
    },
    "input_region": {
      "space": "conservative_momentum",
      "vars": [
        "u",
        "v",
        "w"
      ],
      "x": [
        0.20291667,
        1.9470833
      ],
      "y": [
        0.0,
        0.29627645
      ]
    },
    "mask_bc_forcing": true
  }
}

{
  // Case 1 fd-order sweep with the smooth localized sponge fixed at sigma_max=0.5.
  //
  // Run with:
  //   LINSTABPY_CASE1_PERF_CONFIG=examples/case_studies/case1_song/perf_memory_cases_fd_sponge.jsonc ../../.venv/bin/python examples/case_studies/case1_song/perf_memory.py

  "outputs": {
    "report_json": "output/fd_sponge/case1_perf_memory_latest.json",
    "report_csv": "output/fd_sponge/case1_perf_memory_table.csv",
    "log_dir": "output/fd_sponge/logs",
    "run_dir": "output/fd_sponge/runs"
  },

  "defaults": {
    "base_config": "parity_config.jsonc",
    "monitor_interval_seconds": 0.5,
    "python_exe": "../../.venv/bin/python",
    "env": {
      "OMP_NUM_THREADS": "1",
      "OPENBLAS_NUM_THREADS": "1",
      "MKL_NUM_THREADS": "1",
      "NUMEXPR_NUM_THREADS": "1"
    },
    "launcher": {
      "mpi_procs": 10,
      "launcher": "mpiexec"
    },
    "case_defaults": {
      "config_overrides": {
        "numerics": {
          "stride_ksi": 1,
          "stride_eta": 1,
          "fd_order": 4,
          "beta": 0.0,
          "alpha_filter": 0.0
        },
        "analysis": {
          "ratio_uinf": 1.0,
          "ratio_l": 0.1,
          "St": 0.1,
          "use_raw_eigs": false,
          "run_stability": true,
          "run_resolvent": false,
          "n_modes_stability": 300
        },
        "physics": {
          "use_matlab_sponge_aux": false,
          "sponge": {
            "enabled": true,
            "preset": "case1_smooth_soft"
          }
        },
        "solver": {
          "petsc_matrix_mode": "distributed",
          "eigen": {
            "st_solver": "mumps",
            "eps_tol": 1e-6,
            "ncv": 700,
            "conv_test": "rel",
            "true_residual": true
          },
          "linsolve": {
            "type": "mumps"
          },
          "resolvent": {
            "type": "mumps",
            "eigen": {
              "eps_tol": 1e-8,
              "ncv": 40,
              "conv_test": "rel",
              "true_residual": true,
              "eps_max_it": 1000
            }
          }
        }
      }
    }
  },

  "cases": [
    {
      "case_id": "case1_fd4_sponge_sigma_0p5",
      "label": "Case 1 fd4 smooth sponge sigma_max=0.5",
      "enabled": true
    },
    {
      "case_id": "case1_fd6_sponge_sigma_0p5",
      "label": "Case 1 fd6 smooth sponge sigma_max=0.5",
      "enabled": true,
      "config_overrides": {
        "numerics": {
          "fd_order": 6
        }
      }
    },
    {
      "case_id": "case1_fd8_sponge_sigma_0p5",
      "label": "Case 1 fd8 smooth sponge sigma_max=0.5",
      "enabled": true,
      "config_overrides": {
        "numerics": {
          "fd_order": 8
        }
      }
    }
  ]
}

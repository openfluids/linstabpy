{
  "paths": {
    "case_dir": "data/baseflow",
    "case_inputs_mat": "reference/matlab/MATLAB_exports_resolvent/case_inputs_used.mat"
  },
  "physics": {
    "Re": 395000.0,
    "Ma": 2.0,
    "Pr": 0.747,
    "kappa": 1.4,
    "T_0": 1540.0,
    "zero_mu_t_derivs": true,
    "zero_spanwise": false,
    "use_matlab_sponge_aux": false,
    "sponge": {
      "enabled": true,
      "preset": "case1_smooth_half"
    }
  },
  "numerics": {
    "stride_ksi": 1,
    "stride_eta": 1,
    "fd_order": 4,
    "beta": 0.0,
    "alpha_filter": 0.0
  },
  "bc": {
    "penalty": 1e8,
    "recipe": [
      {"type": "dirichlet", "borders": "lt", "variables": "ruvwT"},
      {"type": "dirichlet", "borders": "b", "variables": "ruvw"},
      {"type": "neumann", "borders": "b", "variables": "T"},
      {"type": "neumann", "borders": "r", "variables": "ruvwT"}
    ]
  },
  "analysis": {
    "ratio_uinf": 1.0,
    "ratio_l": 0.1,
    "St": 0.1,
    "use_raw_eigs": false,
    "run_stability": false,
    "run_resolvent": true,
    "n_modes_resolvent": 3
  },
  "solver": {
    "petsc_matrix_mode": "distributed",
    "eigen": {
      "st_solver": "mumps",
      "eps_tol": 1e-6,
      "ncv": 300,
      "conv_test": "rel",
      "true_residual": true
    },
    "linsolve": {
      "type": "mumps"
    },
    "resolvent": {
      "type": "mumps",
      "eigen": {
        "eps_tol": 1e-8,
        "ncv": 40,
        "conv_test": "rel",
        "true_residual": true,
        "eps_max_it": 1000
      }
    }
  }
}

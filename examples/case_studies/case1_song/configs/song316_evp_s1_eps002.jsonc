// =============================================================================
// Ziming Song 31.6 deg SWBLI EVP -- resolution ladder rung (stride 1/1, eps=0.02).
// This rung: 601,995 DOF, omega_i = -5.010641e-02. THE PUBLISHABLE RUNG -- full resolution on Ziming's 600x200 mesh.
//
// PURPOSE: establish how the leading global eigenvalue converges with mesh
// resolution, and thereby fix the unit convention relating our eigenvalue to the
// reference value.
//
// RESULT -- the ladder is CLOSED; this config is kept as the reproducibility
// record. At eps=0.02, sigma=0, fd4, beta*X_sh=19.04:
//     stride 4     38,250 DOF   omega_i = -4.281e-02    ratio to reference 68.53
//     stride 3     67,000 DOF             -4.577e-02                       73.26
//     stride 2    151,500 DOF             -4.849e-02                       77.63
//     stride 1    601,995 DOF             -5.010641e-02                    80.21
// The ratio converges on 80, which is X_sh/mm. The reference grid is in
// millimetres and ours in units of X_sh = 80 mm, so the reference angular
// frequency is expressed in U_inf/mm while ours is in U_inf/X_sh. Scaling the
// reference by 80 gives -4.997445e-02, which the stride-1 rung matches to 0.26%.
//
// So the apparent ~67x gap was a UNIT CONVENTION, not a numerical defect. Two
// independent lines confirm it: (a) the eps ladder showed omega_i is insensitive
// to dissipation (3.1% spread over eps in [0,0.10]; the bare operator gives
// -4.37e-2), so damping was never the cause; (b) mode shapes correlate at
// |corr| = 0.9998 (u), 0.9997 (T), 0.9979 (v), 0.9704 (rho) -- same physical
// mode, and correlation is convention-independent.
//
// HONEST CAVEAT: the last refinement step still moves omega_i by 3.32%, so this
// is agreement better than 1% AT FULL RESOLUTION ON THIS MESH, not a converged
// continuum limit. Do not quote it as the latter. An Aitken extrapolation was
// computed and judged unreliable on three points; it is deliberately not reported.
//
// VERDICT: omega_i < 0 in both ours and the reference, so 31.6 deg is stable in
// its least-damped global mode. The resolvent map on this base flow therefore
// needs no unstable-mode discounting.
//
// Controlled comparison: identical to configs/song316_evp_s4_eps002.jsonc except
// stride_ksi/stride_eta. eps fixed at 0.02 (mid-plateau).
// =============================================================================
{
  "paths": {
    "case_dir": "data/song_31.6/converted"
  },

  "physics": {
    "Re": 100000.0,
    "Ma": 2.15,
    "Pr": 0.72,
    "kappa": 1.4,
    "T_0": 153.33,
    "zero_spanwise": false,
    "zero_mu_t_derivs": false,
    "use_matlab_sponge_aux": false,
    "sponge": {
      "enabled": true,
      "preset": "case1_smooth_half"
    }
  },

  "numerics": {
    "stride_ksi": 1,
    "stride_eta": 1,
    "fd_order": 4,
    "beta": 19.04,
    "alpha_filter": 0.0,
    "operator_dissipation": {
      "enabled": true,
      "epsilon": 0.02,
      "apply_to_stability": true
    }
  },

  "bc": {
    "penalty": 100000000.0,
    "recipe": [
      {"type": "dirichlet", "borders": "lt", "variables": "ruvwT"},
      {"type": "dirichlet", "borders": "b", "variables": "ruvw"},
      {"type": "neumann", "borders": "b", "variables": "T"},
      {"type": "neumann", "borders": "r", "variables": "ruvwT"}
    ]
  },

  "analysis": {
    "ratio_uinf": 1.0,
    "ratio_l": 0.1,
    "St": 0.1,
    "run_stability": true,
    "run_resolvent": false,
    "use_raw_eigs": false,
    "n_modes_stability": 40,
    "omega_target": {"real": 0.0, "imag": 0.0}
  },

  "solver": {
    "petsc_matrix_mode": "distributed",
    "eigen": {
      "st_solver": "mumps",
      "eps_tol": 1e-6,
      "ncv": 160,
      "conv_test": "rel"
    },
    "linsolve": {"type": "mumps"}
  }
}

// =============================================================================
// Song SWBLI box — global EVP (stationary global mode).
//
// SELF-CONTAINED: no base_config inheritance. Everything the driver needs is
// inline so this file ships with the code as a complete, reproducible case.
// Run directly:
//   LINSTABPY_CASE1_CONFIG=configs/song_box_evp.jsonc \
//     mpiexec -n 10 <venv>/python -m case1
//
// Base flow: full-resolution 601x301 LAMINAR box (rectangular x in [0,160],
// y in [0,80], in units of X_sh = 80 mm), built by tools/ziming_box_to_npy.py.
// Fields are nondimensionalized as: rho/rho_inf, u/c_inf (so u_freestream ~ Ma),
// T/T_inf. Verified freestream: rho~1.0, u_max=2.1505 (=Ma), T_min=1.0.
//
// PHYSICS — verified against the box base flow, NOT inherited from the MATLAB
// parity oracle (which used Ma=2.0, Re=395000, T_0=1540 for a different dataset
// and would silently assemble the wrong compressible operator here):
//   * Ma=2.15   : enters the energy/pressure operator explicitly as Ma^2
//                 (coefficients.py:649-723, cv=1/(kappa(kappa-1)Ma^2)); must
//                 match the base-flow velocity scale (u_freestream=2.15).
//   * Re=1.0e5  : freestream Re_Xsh; viscous terms scale as 1/Re. Cross-checked
//                 from first principles: rho_inf*U_inf*X_sh/mu(T_inf) ~ 1.01e5.
//   * T_0=153.33: Sutherland reference temperature [K]. The box T is normalized
//                 by T_inf=153.33 K (freestream T_nondim=1.0), and Sutherland
//                 uses Tstar = T_nondim * T_0 (viscosity.py:44) to recover
//                 Kelvin. T_0=1540 would evaluate viscosity ~10x too hot.
//   * Pr=0.72, kappa=1.4 : Song SWBLI values.
//
// DISSIPATION (mandatory on this mesh): SBP operator dissipation damps the
// grid-scale odd/even (sawtooth) modes that otherwise appear as spurious
// high-growth eigenvalues. The EVP/driver path reads epsilon from
// numerics.operator_dissipation.epsilon (NOT top-level dissipation_epsilon).
// epsilon below is the box-resolution value from the eps-sweep calibration.
// =============================================================================
{
  "paths": {
    // CANONICAL box base flow = freestream-1 convention (from MATLAB base_flow.mat).
    // NOT baseflow_box601 (that was the mis-scaled u*Ma / T*Ma^2 field — VOID).
    "case_dir": "data/baseflow_box_matlab_full"
  },

  "physics": {
    "Re": 100000.0,
    "Ma": 2.15,
    "Pr": 0.72,
    "kappa": 1.4,
    // Sutherland Kelvin-reference T_0 = T_inf = 153.33 K (matches the freestream-1
    // base-flow convention: T* = T/T_inf, freestream T*=1 -> Tstar = 153.33 K).
    // The earlier "T_0=33.17 for a T*=Ma^2 scale" was WRONG (see memory
    // feedback_baseflow_convention). Verified vs MATLAB LinStab2D main.m (T_0=153.33).
    "T_0": 153.33,

    "zero_spanwise": false,
    // Include the physical Sutherland dMU/dT terms (the parity oracle zeroed
    // them only to match MATLAB exports that omitted them). REVIEW: confirm we
    // want the full temperature-dependent-viscosity coupling for the box.
    "zero_mu_t_derivs": false,

    "use_matlab_sponge_aux": false,
    "sponge": {
      "enabled": true,
      "preset": "case1_smooth_half"
    }
  },

  "numerics": {
    "stride_ksi": 1,
    "stride_eta": 1,
    "fd_order": 4,
    "beta": 19.2,            // beta*L; peak growth lambda/L=0.327. Runner overrides for a sweep.
    "alpha_filter": 0.0,
    "operator_dissipation": {
      "enabled": true,
      "epsilon": 0.10,       // PLACEHOLDER — replace with box eps-sweep result.
      "apply_to_stability": true
    }
  },

  "bc": {
    "penalty": 100000000.0,
    "recipe": [
      {"type": "dirichlet", "borders": "lt",  "variables": "ruvwT"},
      {"type": "dirichlet", "borders": "b",   "variables": "ruvw"},
      {"type": "neumann",   "borders": "b",   "variables": "T"},
      {"type": "neumann",   "borders": "r",   "variables": "ruvwT"}
    ]
  },

  "analysis": {
    "ratio_uinf": 1.0,
    "ratio_l": 0.1,
    "St": 0.1,

    "run_stability": true,
    "run_resolvent": false,
    "use_raw_eigs": false,
    "n_modes_stability": 20,

    // Stationary global mode lives at omega ~ 0 + i*6.7e-4 (Song mode 1).
    // Shift-invert at the origin.
    "omega_target": { "real": 0.0, "imag": 0.0 }
  },

  "solver": {
    "petsc_matrix_mode": "distributed",
    "eigen": {
      "st_solver": "mumps",
      "eps_tol": 1e-6,
      "ncv": 160,
      "conv_test": "rel",
      "true_residual": false
    },
    "linsolve": { "type": "mumps" }
  }
}

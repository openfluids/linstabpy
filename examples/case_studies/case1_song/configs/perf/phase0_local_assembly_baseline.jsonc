{
  // Bounded Case 1 P8 baseline for timing/RSS instrumentation.
  //
  // This intentionally stops after operator assembly and output saving. The
  // full Case 1 eigensolve baselines are tracked separately because the
  // production nev=150 sweep can be much longer than a local matrix check.

  "outputs": {
    "report_json": "output/phase0_local_assembly_baseline/case1_phase0_local_assembly_baseline_latest.json",
    "report_csv": "output/phase0_local_assembly_baseline/case1_phase0_local_assembly_baseline_table.csv",
    "log_dir": "output/phase0_local_assembly_baseline/logs",
    "run_dir": "output/phase0_local_assembly_baseline/runs"
  },

  "defaults": {
    "base_config": "parity_config.jsonc",
    "monitor_interval_seconds": 0.5,
    "python_exe": "../../../../../.venv/bin/python",
    "env": {
      "OMP_NUM_THREADS": "1",
      "OPENBLAS_NUM_THREADS": "1",
      "MKL_NUM_THREADS": "1",
      "NUMEXPR_NUM_THREADS": "1"
    },
    "launcher": {
      "mpi_procs": 2,
      "launcher": "mpiexec"
    },
    "case_defaults": {
      "config_overrides": {
        "numerics": {
          "stride_ksi": 4,
          "stride_eta": 4,
          "fd_order": 4,
          "beta": 0.0,
          "alpha_filter": 0.0
        },
        "analysis": {
          "use_raw_eigs": false,
          "run_stability": false,
          "run_resolvent": false,
          "n_modes_stability": 4
        },
        "physics": {
          "use_matlab_sponge_aux": false,
          "sponge": {
            "enabled": false,
            "preset": "case1_stability"
          }
        },
        "solver": {
          "petsc_matrix_mode": "distributed",
          "eigen": {
            "st_solver": "mumps",
            "eps_tol": 1e-6,
            "ncv": 40,
            "conv_test": "rel",
            "true_residual": true
          },
          "linsolve": {
            "type": "mumps"
          }
        }
      }
    }
  },

  "cases": [
    {
      "case_id": "case1_stride4_fd4_assembly_only",
      "label": "Case 1 assembly-only P8 baseline: stride4 fd4",
      "enabled": true
    }
  ]
}

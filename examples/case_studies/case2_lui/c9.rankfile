# c9.rankfile -- GENERICISED TEMPLATE (public repo: localhost only, no real hostnames).
# Open MPI rankfile form. Use via LINSTABPY_MPI_RANKFILE=.../c9.rankfile, or replace
# the host/slot map with your node's real layout at runtime. The real c9 node specifics
# are NOT committed here.
rank 0=localhost slot=0
rank 1=localhost slot=1
rank 2=localhost slot=2
rank 3=localhost slot=3
rank 4=localhost slot=4
rank 5=localhost slot=5
rank 6=localhost slot=6
rank 7=localhost slot=7
rank 8=localhost slot=8
rank 9=localhost slot=9

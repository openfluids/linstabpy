{
  // Shared defaults for Case 2 EVP sweep configs.
  //
  // Each `evp_stride*.jsonc` sets `"$include": "../_defaults.jsonc"` and
  // overrides only the knobs that vary per experiment
  // (stride, n_modes_stability, ncv, eps_tol, eps_max_it,
  // stability_acceptance, cases).
  //
  // See perf_memory.py: `_load_jsonc_with_includes` deep-merges the
  // including file on top of this base.

  "defaults": {
    "base_config": "parity_config.jsonc",
    "case_workdir": "../..",
    "monitor_interval_seconds": 0.5,
    "python_exe": "../../.venv/bin/python",
    "env": {
      "OMP_NUM_THREADS": "1",
      "OPENBLAS_NUM_THREADS": "1",
      "MKL_NUM_THREADS": "1",
      "NUMEXPR_NUM_THREADS": "1"
    },
    "launcher": {
      "mpi_procs": 10,
      "launcher": "mpiexec --rankfile /home/ghamada/linstabpy/examples/case_studies/case2_lui/socket0.rankfile --bind-to core"
    },
    "case_defaults": {
      "config_overrides": {
        "numerics": {
          "fd_order": 4,
          "beta": 0.0,
          "alpha_filter": "none"
        },
        "analysis": {
          "ratio_uinf": 1.0,
          "ratio_l": 0.1,
          "St": 0.1,
          "run_stability": true,
          "run_resolvent": false
        },
        "solver": {
          "petsc_matrix_mode": "distributed",
          "eigen": {
            "st_solver": "mumps",
            "conv_test": "rel",
            "true_residual": true,
            "residual_error_type": "relative",
            "extract_all_converged": true,
            "monitor": true,
            "monitor_every": 5
          },
          "linsolve": {
            "type": "mumps"
          }
        }
      }
    }
  }
}

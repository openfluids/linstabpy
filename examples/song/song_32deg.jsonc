{
  // Song & Hao (2023) / Robinet (2007) oblique SWBLI validation case
  // Configuration: oblique shock on flat-plate laminar BL
  // Reference: Robinet (2007) JFM 579:85-112, Song & Hao (2023) PoF 35:084119

  // Flow parameters
  "Re": 1e5,          // Reynolds number (based on distance to impingement)
  "Ma": 2.15,         // Mach number
  "Pr": 0.72,         // Prandtl number
  "kappa": 1.4,       // Ratio of specific heats
  "T_0": 153.33,      // Reference temperature [K]

  // Frequency target specification
  "beta": 19.2,       // Spanwise wavenumber
  // Preferred: give omega_target directly in solver units.
  // Legacy: St is still accepted and converted as omega_target = 2π St.
  // For more general Strouhal definitions, use:
  // "frequency_target": {"St": 0.02, "omega_scale": 6.283185307179586}
  // or specify omega directly with:
  // "frequency_target": {"omega": [0.0, 0.125]}
  "St": 0.0,          // Legacy Strouhal input; use omega_target/frequency_target for general cases

  // Solver settings
  "n_modes_stability": 20,   // Number of eigenvalues to report/save
  "stability_search_extra_modes": 4, // Over-extract a few extra modes so paired deep-damped branches are less likely to be cut by the 20-mode window
  "n_modes_resolvent": 10,   // Number of resolvent singular values (ignored while disabled)
  "run_stability": true,     // Run temporal eigenvalue analysis
  "run_resolvent": false,    // Disable resolvent analysis for now; stability only

  // Discretization
  "fd_order": 2,             // SBP finite-difference order
  "stride_ksi": 1,           // Streamwise stride (1 = full resolution)
  "stride_eta": 1,           // Wall-normal stride
  "penalty": 1e8,            // BC penalty parameter
  "alpha_filter": "none",    // Implicit filter strength ("none" to disable)

  // Input layout
  "baseflow_input": {
    // Song's saved .npy fields follow the original MATLAB storage layout:
    // axis 0 marches in x and axis 1 marches in y. The mesh builder expects
    // the repo convention (ny, nx), so transpose once before assembly.
    "transpose_input": true,
    "zero_spanwise": false
  },

  // Baseflow preprocessing
  // After correcting the Song input orientation, this explicit filter branch
  // is currently closer to the MATLAB reduced-spectrum reference than the raw
  // unfiltered branch. Keep the raw branch available in the matrix runner as a
  // diagnostic comparison, but use this filtered path as the default recipe.
  "baseflow_preprocess": {
    "enabled": true,
    "sponge": {
      "scale": 1.0,
      "boundary": {
        "enabled": false,
        "mode": "add",             // one of: add, max, replace
        "points": [0, 0, 0, 0],     // [top, right, bottom, left]
        "amplitudes": [0.0, 0.0, 0.0, 0.0]
      }
    },
    "filter": {
      "enabled": true,
      "passes": 1,
      "fields": ["rho", "u", "v", "T"],
      "directions": ["x", "y"],
      "eta_min_index": 8,
      "eta_max_index": null
    },
    "shock": {
      "enabled": false
    }
  },

  // Boundary conditions
  "bc": {
    "penalty": 1e8,
    "recipe": [
      {"type": "dirichlet", "borders": "lt",  "variables": "ruvwT"},
      {"type": "dirichlet", "borders": "b",   "variables": "ruvw"},
      {"type": "neumann",   "borders": "b",   "variables": "T"},
      {"type": "neumann",   "borders": "r",   "variables": "ruvwT"}
    ]
  },

  // Optional assembly backend: "scipy", "petsc", or "auto"
  // Song is a local 2D LNSE case, so the native PETSc path is applicable here.
  "assembly_backend": "auto",

  // Solver configuration
  "solver": {
    "petsc_matrix_mode": "auto",
    "linsolve": {
      "type": "mumps"
    }
  }
}

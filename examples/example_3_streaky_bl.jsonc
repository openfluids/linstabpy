{
  // Example 3: Streaky boundary-layer temporal and spatial analysis
  // Periodic x-domain with Hanifi-like y stretch, temporal eigenvalues,
  // and spatial eigenvalues in generalized (alpha) form.

  // Grid
  "nx": 125,
  "ny": 250,
  "fd_order": 4,
  "alpha_filter": 0.0,
  "Lx": 3.141592653589793,  // pi
  "Ly": 5.0,
  "x_periodicity": true,

  // Mesh stretch (Hanifi)
  "y_stretch_yi": 2.0,

  // Sponge
  "sponge": {
    "amplitude": 0.1,
    "ys_offset": 1.0,       // Ly - ys_offset = sponge start
    "ys_trans": 0.5
  },

  // Temporal eigenvalue analysis
  // Each target is [real, imag]; quotas say how many modes to keep per target
  "temporal_targets": [[0.59, 0.02], [0.626, -0.005]],
  "temporal_quotas": [2, 8],
  "n_modes": 50,
  "ncv": 150,               // Arnoldi subspace dimension
  "alpha_temp": 0.6283,     // streamwise wavenumber for temporal solve
  "n_periods": 2,           // Floquet periodicity (0 = no Floquet)
  "dedupe_tol": 1e-4,

  // Spatial eigenvalue analysis
  "spatial_omega_imag_shift": 0.0,

  // Run flags
  "run_temporal": true,
  "run_spatial": true,
  "model": "2D",

  // Boundary conditions
  "bc": {
    "recipe": [
      {"type": "dirichlet", "borders": "tb", "variables": "uvwT"}
    ]
  },

  // Optional assembly backend for the temporal/spatial operators:
  // "scipy" keeps the historical SciPy assembly path,
  // "petsc" uses direct PETSc assembly for the validated local 2D path.
  "assembly_backend": "scipy",

  // Solver configuration
  "solver": {
    "petsc_matrix_mode": "auto",
    "linsolve": {
      "type": "mumps"
    }
  }
}

#!/bin/bash
#SBATCH --job-name={jobname}
#SBATCH --output={workdir}/slurm-%j.out
#SBATCH --error={workdir}/slurm-%j.err
#SBATCH --partition={partition}
#SBATCH --time=04:00:00
#SBATCH --ntasks={nranks}
#SBATCH --cpus-per-task=1
set -euo pipefail
set +u
# setvars.sh --force returns non-zero when oneAPI is already in the submitting shell;
# under set -e that killed the job before mpiexec (job 1860).
if [ -f /opt/intel/oneapi/setvars.sh ]; then . /opt/intel/oneapi/setvars.sh --force >/dev/null 2>&1 || true; fi
set -u
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
# Rank placement decides the factor time (1.6x on c9, job 1861): print the pin map into
# this log, and take the job's own I_MPI_* / LINSTABPY_PYTHON from the generator.
export I_MPI_DEBUG=4
{env_lines}PY="${{LINSTABPY_PYTHON:-$HOME/linstabpy/.venv/bin/python}}"
export PYTHONPATH="{repo_root}/src:{repo_root}${{PYTHONPATH:+:$PYTHONPATH}}"
cd {repo_root}
echo "SHA=$(git -C {repo_root} rev-parse HEAD)  BETA={beta}  F={freq}"
echo "resolution=full-res 300x300 stride=1  epsilon=0  leak=rectilinear"
LINSTABPY_CASE1_CONFIG={config} \
LINSTABPY_CASE1_OUTPUT_NPZ={output_npz} \
mpiexec -n {nranks} "$PY" -u -c "from linstabpy.driver.run import run; run()"
echo "DONE {jobname}"

{
  // Song2023 fd6 stride-1 resolvent-only run for the TCFD campaign.
  //
  // Use with:
  //   .venv/bin/python -m validation.song_2023.scripts.run_song_2023_matrix \
  //     --config validation/song_2023/configs/song_2023_resolvent_fd6.jsonc
  //
  // This keeps the generated run config and outputs under
  // validation/song_2023/resolvent_runs/ instead of leaving canonical
  // song_2023.npz files in the validation directory.

  "output_root": "validation/song_2023/resolvent_runs",

  "base_config": "validation/song_2023/configs/song_2023.jsonc",

  "variants": [
    {
      "name": "fd6_stride1_resolvent_only",
      "overrides": {
        "fd_order": 6,
        "run_stability": false,
        "run_resolvent": true,
        "n_modes_resolvent": 10,
        "assembly_backend": "petsc",
        "solver": {
          "petsc_matrix_mode": "local",
          "linsolve": {"type": "mumps"},
          "resolvent": {
            "eigen": {
              "eps_tol": 1e-8
            }
          }
        }
      }
    }
  ]
}

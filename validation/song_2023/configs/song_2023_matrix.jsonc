{
  // Song2023 / Robinet validation matrix.
  //
  // Keep solver choices in JSONC and write variant outputs under
  // validation/song_2023/matrix_runs so the canonical song_2023.npz is untouched.

  "output_root": "validation/song_2023/matrix_runs",

  "base_config": "validation/song_2023/configs/song_2023.jsonc",

  // Optional reduced-case overrides for quick validation loops.
  // These do not change the canonical song_2023.jsonc; they only apply when
  // the runner is invoked with --reduced.
  "reduced_overrides": {
    "stride_ksi": 2,
    "stride_eta": 2,
    "n_modes_stability": 8
  },

  "variants": [
    {
      "name": "scipy_assembly__mumps",
      "overrides": {
        "assembly_backend": "scipy",
        "solver": {
          "petsc_matrix_mode": "local",
          "eigen": {
            "st_solver": "mumps"
          },
          "linsolve": {
            "type": "mumps"
          }
        }
      }
    },
    {
      "name": "petsc_assembly__mumps",
      "overrides": {
        "assembly_backend": "petsc",
        "solver": {
          "petsc_matrix_mode": "local",
          "eigen": {
            "st_solver": "mumps"
          },
          "linsolve": {
            "type": "mumps"
          }
        }
      }
    },
    {
      "name": "petsc_assembly__mumps__raw",
      "overrides": {
        // Diagnostic raw branch: same corrected Song input orientation, but
        // with preprocessing disabled so we can separate mesh/layout fixes
        // from the explicit filter choice.
        "baseflow_preprocess": {
          "enabled": false
        },
        "assembly_backend": "petsc",
        "solver": {
          "petsc_matrix_mode": "local",
          "eigen": {
            "st_solver": "mumps"
          },
          "linsolve": {
            "type": "mumps"
          }
        }
      }
    },
    {
      "name": "petsc_assembly__mumps__fd4",
      "overrides": {
        // Same corrected Song recipe, but with a 4th-order SBP stencil so we
        // can compare accuracy/cost against the current 2nd-order baseline.
        "fd_order": 4,
        "assembly_backend": "petsc",
        "solver": {
          "petsc_matrix_mode": "local",
          "eigen": {
            "st_solver": "mumps"
          },
          "linsolve": {
            "type": "mumps"
          }
        }
      }
    },
    {
      "name": "petsc_assembly__mumps__fd6",
      "overrides": {
        // Same corrected Song recipe, but with a 6th-order SBP stencil for
        // the next accuracy/cost comparison point.
        "fd_order": 6,
        "assembly_backend": "petsc",
        "solver": {
          "petsc_matrix_mode": "local",
          "eigen": {
            "st_solver": "mumps"
          },
          "linsolve": {
            "type": "mumps"
          }
        }
      }
    },
    {
      "name": "scipy_assembly__krylov_lu_pc",
      "overrides": {
        "assembly_backend": "scipy",
        "omega_target": [0.0, 0.06218175],
        "solver": {
          "petsc_matrix_mode": "local",
          "eigen": {
            "st_solver": "iterative",
            "ksp_type": "gmres",
            "pc_type": "lu",
            "pc_factor_solver_type": "mumps",
            "ksp_pc_side": "right",
            "ksp_rtol": 1e-8,
            "ksp_max_it": 20000
          }
        }
      }
    },
    {
      "name": "petsc_assembly__krylov_lu_pc",
      "overrides": {
        "assembly_backend": "petsc",
        "omega_target": [0.0, 0.06218175],
        "solver": {
          "petsc_matrix_mode": "local",
          "eigen": {
            "st_solver": "iterative",
            "ksp_type": "gmres",
            "pc_type": "lu",
            "pc_factor_solver_type": "mumps",
            "ksp_pc_side": "right",
            "ksp_rtol": 1e-8,
            "ksp_max_it": 20000
          }
        }
      }
    },
    {
      "name": "scipy_assembly__krylov_lu_pc__mgs_refine",
      "overrides": {
        "assembly_backend": "scipy",
        "omega_target": [0.0, 0.06218175],
        "solver": {
          "petsc_matrix_mode": "local",
          "eigen": {
            "st_solver": "iterative",
            "ksp_type": "gmres",
            "pc_type": "lu",
            "pc_factor_solver_type": "mumps",
            "ksp_pc_side": "right",
            "ksp_rtol": 1e-8,
            "ksp_max_it": 20000,
            "gmres_orthogonalization": "modified",
            "gmres_cgs_refinement_type": "refine_always",
            "gmres_restart": 100
          }
        }
      }
    },
    {
      "name": "petsc_assembly__krylov_lu_pc__mgs_refine",
      "overrides": {
        "assembly_backend": "petsc",
        "omega_target": [0.0, 0.06218175],
        "solver": {
          "petsc_matrix_mode": "local",
          "eigen": {
            "st_solver": "iterative",
            "ksp_type": "gmres",
            "pc_type": "lu",
            "pc_factor_solver_type": "mumps",
            "ksp_pc_side": "right",
            "ksp_rtol": 1e-8,
            "ksp_max_it": 20000,
            "gmres_orthogonalization": "modified",
            "gmres_cgs_refinement_type": "refine_always",
            "gmres_restart": 100
          }
        }
      }
    }
  ]
}

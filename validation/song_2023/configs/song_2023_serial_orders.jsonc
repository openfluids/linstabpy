{
  // Serial Song2023 order-convergence study on the current laptop.
  //
  // Purpose:
  // - build Python spectra for fd2 / fd4 / fd6
  // - keep the study separate from the aborted MPI scaling ladder
  // - stop before the machine becomes unhealthy

  "output_root": "validation/song_2023/serial_order_runs",

  "base_config": "validation/song_2023/configs/song_2023.jsonc",

  "memory_guard": {
    "machine_memory_mib": 16384.0,
    "stop_on_peak_memory_mib_max_rank": 13000.0,
    "stop_on_peak_memory_mib_sum_ranks": 13000.0,
    "stop_on_swap_delta_mib": 4096.0
  },

  "variants": [
    {
      "name": "fd4_rank1_serial",
      "ranks": 1,
      "overrides": {
        "fd_order": 4,
        "assembly_backend": "petsc",
        "solver": {
          "petsc_matrix_mode": "local",
          "linsolve": {"type": "mumps"},
          "eigen": {"st_solver": "mumps"}
        }
      }
    },
    {
      "name": "fd6_rank1_serial",
      "ranks": 1,
      "overrides": {
        "fd_order": 6,
        "assembly_backend": "petsc",
        "solver": {
          "petsc_matrix_mode": "local",
          "linsolve": {"type": "mumps"},
          "eigen": {"st_solver": "mumps"}
        }
      }
    }
  ]
}

{
  // Sequential full Song2023 rank/order benchmark on the current workstation.
  //
  // Run order:
  // - fd2: ranks 20, 10
  // - fd4: ranks 20, 10
  // - fd6: ranks 20, 10
  // - fd8: ranks 20, 10
  //
  // Stop as soon as:
  // - a run fails
  // - distributed proof is missing on ranks > 1
  // - peak memory exceeds configured guard
  // - swap usage grows beyond the configured delta guard

  "output_root": "validation/song_2023/scaling_runs",

  "base_config": "validation/song_2023/configs/song_2023.jsonc",

  // Memory guard for the current Linux workstation (~1.5 TiB RAM).
  // Keep these high enough that we exercise the full ladder unless there is
  // a genuine runaway allocation or factorization blow-up.
  "memory_guard": {
    "machine_memory_mib": 1572864.0,
    "stop_on_peak_memory_mib_max_rank": 900000.0,
    "stop_on_peak_memory_mib_sum_ranks": 1200000.0,
    "stop_on_swap_delta_mib": 4096.0
  },

  "variants": [
    {
      "name": "fd2_rank20_dist",
      "ranks": 20,
      "overrides": {
        "fd_order": 2,
        "assembly_backend": "petsc",
        "solver": {
          "petsc_matrix_mode": "distributed",
          "linsolve": {"type": "mumps"},
          "eigen": {"st_solver": "mumps"}
        }
      }
    },
    {
      "name": "fd2_rank10_dist",
      "ranks": 10,
      "overrides": {
        "fd_order": 2,
        "assembly_backend": "petsc",
        "solver": {
          "petsc_matrix_mode": "distributed",
          "linsolve": {"type": "mumps"},
          "eigen": {"st_solver": "mumps"}
        }
      }
    },
    {
      "name": "fd4_rank20_dist",
      "ranks": 20,
      "overrides": {
        "fd_order": 4,
        "assembly_backend": "petsc",
        "solver": {
          "petsc_matrix_mode": "distributed",
          "linsolve": {"type": "mumps"},
          "eigen": {"st_solver": "mumps"}
        }
      }
    },
    {
      "name": "fd4_rank10_dist",
      "ranks": 10,
      "overrides": {
        "fd_order": 4,
        "assembly_backend": "petsc",
        "solver": {
          "petsc_matrix_mode": "distributed",
          "linsolve": {"type": "mumps"},
          "eigen": {"st_solver": "mumps"}
        }
      }
    },
    {
      "name": "fd6_rank20_dist",
      "ranks": 20,
      "overrides": {
        "fd_order": 6,
        "assembly_backend": "petsc",
        "solver": {
          "petsc_matrix_mode": "distributed",
          "linsolve": {"type": "mumps"},
          "eigen": {"st_solver": "mumps"}
        }
      }
    },
    {
      "name": "fd6_rank10_dist",
      "ranks": 10,
      "overrides": {
        "fd_order": 6,
        "assembly_backend": "petsc",
        "solver": {
          "petsc_matrix_mode": "distributed",
          "linsolve": {"type": "mumps"},
          "eigen": {"st_solver": "mumps"}
        }
      }
    },
    {
      "name": "fd8_rank20_dist",
      "ranks": 20,
      "overrides": {
        "fd_order": 8,
        "assembly_backend": "petsc",
        "solver": {
          "petsc_matrix_mode": "distributed",
          "linsolve": {"type": "mumps"},
          "eigen": {"st_solver": "mumps"}
        }
      }
    },
    {
      "name": "fd8_rank10_dist",
      "ranks": 10,
      "overrides": {
        "fd_order": 8,
        "assembly_backend": "petsc",
        "solver": {
          "petsc_matrix_mode": "distributed",
          "linsolve": {"type": "mumps"},
          "eigen": {"st_solver": "mumps"}
        }
      }
    }
  ]
}

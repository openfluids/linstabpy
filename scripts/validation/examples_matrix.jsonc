{
  // Example robustness matrix.
  //
  // Baseline example re-execution should still happen via run_all_examples.sh.
  // This file drives variant runs that must NOT overwrite the canonical
  // examples/example_*.npz artifacts.

  // All variant artifacts and summaries are written underneath this folder.
  "output_root": "validation/example_matrix_runs",

  // Named override bundles reused across examples.
  "variants": {
    "baseline": {},

    "scipy_assembly__mumps": {
      "assembly_backend": "scipy",
      "solver": {
        "petsc_matrix_mode": "local",
        "eigen": {
          "st_solver": "mumps"
        },
        "linsolve": {
          "type": "mumps"
        }
      }
    },

    "petsc_assembly__mumps": {
      "assembly_backend": "petsc",
      "solver": {
        "petsc_matrix_mode": "local",
        "eigen": {
          "st_solver": "mumps"
        },
        "linsolve": {
          "type": "mumps"
        }
      }
    },

    "scipy_assembly__krylov": {
      "assembly_backend": "scipy",
      "solver": {
        "petsc_matrix_mode": "local",
        "eigen": {
          "st_solver": "iterative",
          "ksp_type": "gmres",
          "pc_type": "asm",
          "ksp_pc_side": "left",
          "ksp_rtol": 1e-8,
          "ksp_max_it": 20000,
          "asm_overlap": 2,
          "sub_ksp_type": "preonly",
          "sub_pc_type": "lu"
        },
        "linsolve": {
          "type": "iterative",
          "ksp_type": "fgmres",
          "pc_type": "asm",
          "ksp_pc_side": "right",
          "ksp_rtol": 1e-10,
          "ksp_atol": 1e-14,
          "ksp_max_it": 20000,
          "asm_overlap": 2,
          "sub_ksp_type": "preonly",
          "sub_pc_type": "lu"
        }
      }
    },

    "petsc_assembly__krylov": {
      "assembly_backend": "petsc",
      "solver": {
        "petsc_matrix_mode": "local",
        "eigen": {
          "st_solver": "iterative",
          "ksp_type": "gmres",
          "pc_type": "asm",
          "ksp_pc_side": "left",
          "ksp_rtol": 1e-8,
          "ksp_max_it": 20000,
          "asm_overlap": 2,
          "sub_ksp_type": "preonly",
          "sub_pc_type": "lu"
        },
        "linsolve": {
          "type": "iterative",
          "ksp_type": "fgmres",
          "pc_type": "asm",
          "ksp_pc_side": "right",
          "ksp_rtol": 1e-10,
          "ksp_atol": 1e-14,
          "ksp_max_it": 20000,
          "asm_overlap": 2,
          "sub_ksp_type": "preonly",
          "sub_pc_type": "lu"
        }
      }
    },

    // Current working Krylov-EVP tradeoff for the eigenvalue examples:
    // keep the outer ST/KSP solve iterative (GMRES), but use LU as the PC.
    // This is not the final memory-light target, but it is the first
    // JSONC-only Krylov option that converged reliably on the reduced
    // Example 3 and Example 4 tuning runs.  Lighter PCs (none, jacobi, ilu,
    // asm, bjacobi, current fieldsplit attempts) remain in
    // scripts/validation/krylov_evp_tuning.jsonc as unresolved experiments.
    "scipy_assembly__krylov_lu_pc": {
      "assembly_backend": "scipy",
      "solver": {
        "petsc_matrix_mode": "local",
        "eigen": {
          "st_solver": "iterative",
          "ksp_type": "gmres",
          "pc_type": "lu",
          "ksp_pc_side": "right",
          "ksp_rtol": 1e-8,
          "ksp_max_it": 20000
        }
      }
    },

    "petsc_assembly__krylov_lu_pc": {
      "assembly_backend": "petsc",
      "solver": {
        "petsc_matrix_mode": "local",
        "eigen": {
          "st_solver": "iterative",
          "ksp_type": "gmres",
          "pc_type": "lu",
          "ksp_pc_side": "right",
          "ksp_rtol": 1e-8,
          "ksp_max_it": 20000
        }
      }
    },

    "eigen__krylov_lu_pc": {
      "solver": {
        "petsc_matrix_mode": "local",
        "eigen": {
          "st_solver": "iterative",
          "ksp_type": "gmres",
          "pc_type": "lu",
          "ksp_pc_side": "right",
          "ksp_rtol": 1e-8,
          "ksp_max_it": 20000
        }
      }
    },

    "temporal_eigen__krylov_lu_pc": {
      "run_temporal": true,
      "run_spatial": false,
      "solver": {
        "petsc_matrix_mode": "local",
        "eigen": {
          "st_solver": "iterative",
          "ksp_type": "gmres",
          "pc_type": "lu",
          "ksp_pc_side": "right",
          "ksp_rtol": 1e-8,
          "ksp_max_it": 20000
        }
      }
    }
  },

  // Example-specific run list.
  "examples": [
    {
      "name": "example_0_curvilinear_validation",
      "module": "examples.example_0_curvilinear_validation",
      "config_path": "examples/example_0_curvilinear_validation.jsonc",
      "compute_fn": "compute",
      "kind": "curvilinear",
      "variants": ["baseline"]
    },
    {
      "name": "example_1_blasius",
      "module": "examples.example_1_blasius",
      "config_path": "examples/example_1_blasius.jsonc",
      "compute_fn": "compute",
      "kind": "resolvent",
      "variants": [
        "baseline",
        "scipy_assembly__mumps",
        "petsc_assembly__mumps",
        "petsc_assembly__krylov"
      ]
    },
    {
      "name": "example_2_jet",
      "module": "examples.example_2_jet",
      "config_path": "examples/example_2_jet.jsonc",
      "compute_fn": "compute",
      "kind": "resolvent",
      "variants": [
        "baseline",
        "scipy_assembly__mumps",
        "petsc_assembly__mumps",
        "petsc_assembly__krylov"
      ]
    },
    {
      "name": "example_3_streaky_bl",
      "module": "examples.example_3_streaky_bl",
      "config_path": "examples/example_3_streaky_bl.jsonc",
      "compute_fn": "_compute",
      "kind": "temporal_spatial",
      "variants": [
        "baseline",
        "scipy_assembly__mumps",
        "scipy_assembly__krylov_lu_pc",
        "petsc_assembly__mumps",
        "petsc_assembly__krylov_lu_pc"
      ]
    },
    {
      "name": "example_4_cavity",
      "module": "examples.example_4_cavity",
      "config_path": "examples/example_4_cavity.jsonc",
      "compute_fn": "compute",
      "kind": "cavity_evp",
      "variants": [
        "baseline",
        "scipy_assembly__mumps",
        "scipy_assembly__krylov_lu_pc"
      ]
    },
    {
      "name": "example_5_paraboloid",
      "module": "examples.example_5_paraboloid",
      "config_path": "examples/example_5_paraboloid.jsonc",
      "compute_fn": "compute",
      "kind": "resolvent",
      "variants": [
        "baseline",
        "scipy_assembly__mumps",
        "petsc_assembly__mumps",
        "petsc_assembly__krylov"
      ]
    }
  ]
}

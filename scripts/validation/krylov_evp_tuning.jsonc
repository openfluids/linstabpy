{
  // Reduced-grid Krylov tuning matrix for Example 3 and Example 4.
  //
  // Purpose:
  // - identify PETSc/SLEPc iterative EVP settings that actually converge
  // - keep all solver choices in JSONC instead of hardcoding them in the examples

  "output_root": "validation/krylov_evp_tuning_runs",

  "examples": [
    {
      "name": "example_3_streaky_bl",
      "module": "examples.example_3_streaky_bl",
      "compute_fn": "_compute",
      "config_path": "examples/example_3_streaky_bl.jsonc",
      "reduced_overrides": {
        "nx": 40,
        "ny": 60,
        "n_modes": 6,
        "ncv": 24,
        "temporal_quotas": [2, 2],
        "run_temporal": true,
        "run_spatial": false,
        "assembly_backend": "scipy"
      }
    },
    {
      "name": "example_4_cavity",
      "module": "examples.example_4_cavity",
      "compute_fn": "compute",
      "config_path": "examples/example_4_cavity.jsonc",
      "reduced_overrides": {
        "nx": 81,
        "ny": 41,
        "n_modes": 8,
        "ncv": 40,
        "assembly_backend": "scipy"
      }
    }
  ],

  "trials": [
    {
      "name": "gmres__asm__left",
      "solver": {
        "eigen": {
          "st_solver": "iterative",
          "ksp_type": "gmres",
          "pc_type": "asm",
          "ksp_pc_side": "left",
          "ksp_rtol": 1e-8,
          "ksp_max_it": 20000,
          "asm_overlap": 2,
          "sub_ksp_type": "preonly",
          "sub_pc_type": "lu"
        }
      }
    },
    {
      "name": "gmres__asm__right",
      "solver": {
        "eigen": {
          "st_solver": "iterative",
          "ksp_type": "gmres",
          "pc_type": "asm",
          "ksp_pc_side": "right",
          "ksp_rtol": 1e-8,
          "ksp_max_it": 20000,
          "asm_overlap": 2,
          "sub_ksp_type": "preonly",
          "sub_pc_type": "lu"
        }
      }
    },
    {
      "name": "fgmres__asm__right",
      "solver": {
        "eigen": {
          "st_solver": "iterative",
          "ksp_type": "fgmres",
          "pc_type": "asm",
          "ksp_pc_side": "right",
          "ksp_rtol": 1e-8,
          "ksp_max_it": 20000,
          "asm_overlap": 2,
          "sub_ksp_type": "preonly",
          "sub_pc_type": "lu"
        }
      }
    },
    {
      "name": "gmres__bjacobi__right",
      "solver": {
        "eigen": {
          "st_solver": "iterative",
          "ksp_type": "gmres",
          "pc_type": "bjacobi",
          "ksp_pc_side": "right",
          "ksp_rtol": 1e-8,
          "ksp_max_it": 20000,
          "sub_ksp_type": "preonly",
          "sub_pc_type": "lu"
        }
      }
    },
    {
      "name": "gmres__fieldsplit__left",
      "solver": {
        "eigen": {
          "st_solver": "iterative",
          "ksp_type": "gmres",
          "pc_type": "fieldsplit",
          "ksp_pc_side": "left",
          "ksp_rtol": 1e-8,
          "ksp_max_it": 20000,
          "sub_ksp_type": "preonly",
          "sub_pc_type": "lu"
        }
      }
    },
    {
      "name": "gmres__fieldsplit__right",
      "solver": {
        "eigen": {
          "st_solver": "iterative",
          "ksp_type": "gmres",
          "pc_type": "fieldsplit",
          "ksp_pc_side": "right",
          "ksp_rtol": 1e-8,
          "ksp_max_it": 20000,
          "sub_ksp_type": "preonly",
          "sub_pc_type": "lu"
        }
      }
    },
    {
      "name": "gmres__lu__right",
      "solver": {
        "eigen": {
          "st_solver": "iterative",
          "ksp_type": "gmres",
          "pc_type": "lu",
          "ksp_pc_side": "right",
          "ksp_rtol": 1e-8,
          "ksp_max_it": 20000
        }
      }
    },
    {
      "name": "gmres__ilu__right",
      "solver": {
        "eigen": {
          "st_solver": "iterative",
          "ksp_type": "gmres",
          "pc_type": "ilu",
          "ksp_pc_side": "right",
          "ksp_rtol": 1e-8,
          "ksp_max_it": 20000
        }
      }
    },
    {
      "name": "gmres__jacobi__right",
      "solver": {
        "eigen": {
          "st_solver": "iterative",
          "ksp_type": "gmres",
          "pc_type": "jacobi",
          "ksp_pc_side": "right",
          "ksp_rtol": 1e-8,
          "ksp_max_it": 20000
        }
      }
    },
    {
      "name": "gmres__none__right",
      "solver": {
        "eigen": {
          "st_solver": "iterative",
          "ksp_type": "gmres",
          "pc_type": "none",
          "ksp_pc_side": "right",
          "ksp_rtol": 1e-8,
          "ksp_max_it": 20000
        }
      }
    }
  ]
}

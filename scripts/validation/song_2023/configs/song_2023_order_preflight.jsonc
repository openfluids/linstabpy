{
  // Assembly-only Song2023 order sweep for memory/time estimation on the full grid.
  //
  // Purpose:
  // - estimate operator assembly cost for fd_order = 2, 4, 6, 8
  // - avoid paying for the eigensolve until we know which orders are safe on
  //   the current machine

  "output_root": "validation/song_2023/order_preflight_runs",

  "base_config": "validation/song_2023/configs/song_2023.jsonc",

  // 16 GB laptop guardrail:
  // stay well below the physical limit so the next higher-order run does not
  // push the machine into swap / memory pressure collapse.
  "memory_guard": {
    "machine_memory_mib": 16384.0,
    "stop_on_peak_memory_mib": 12000.0
  },

  "variants": [
    {
      "name": "petsc_assembly__assembleonly__fd2",
      "overrides": {
        "fd_order": 2,
        "run_stability": false,
        "run_resolvent": false,
        "assembly_backend": "petsc",
        "solver": {
          "petsc_matrix_mode": "local",
          "linsolve": {
            "type": "mumps"
          }
        }
      }
    },
    {
      "name": "petsc_assembly__assembleonly__fd4",
      "overrides": {
        "fd_order": 4,
        "run_stability": false,
        "run_resolvent": false,
        "assembly_backend": "petsc",
        "solver": {
          "petsc_matrix_mode": "local",
          "linsolve": {
            "type": "mumps"
          }
        }
      }
    },
    {
      "name": "petsc_assembly__assembleonly__fd6",
      "overrides": {
        "fd_order": 6,
        "run_stability": false,
        "run_resolvent": false,
        "assembly_backend": "petsc",
        "solver": {
          "petsc_matrix_mode": "local",
          "linsolve": {
            "type": "mumps"
          }
        }
      }
    },
    {
      "name": "petsc_assembly__assembleonly__fd8",
      "overrides": {
        "fd_order": 8,
        "run_stability": false,
        "run_resolvent": false,
        "assembly_backend": "petsc",
        "solver": {
          "petsc_matrix_mode": "local",
          "linsolve": {
            "type": "mumps"
          }
        }
      }
    }
  ]
}

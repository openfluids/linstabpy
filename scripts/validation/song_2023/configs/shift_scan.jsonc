{
  // Reduced Song2023 shift scan for direct shifted solves.
  //
  // Purpose:
  // - locate a healthier shift-invert target before retrying Krylov EVP
  // - keep all target choices in JSONC

  "output_root": "validation/song_2023/shift_scan_runs",

  "base_config": "validation/song_2023/configs/song_2023.jsonc",

  "reduced_overrides": {
    "stride_ksi": 2,
    "stride_eta": 2
  },

  // Scan SciPy assembly first because the earlier diagnostics already showed
  // that assembly backend is not the main Song shifted-solve issue.
  "assembly_backends": [
    "scipy"
  ],

  // Candidate omega targets to scan for the shifted solve.
  // We keep real part zero and sweep the imaginary axis around the observed
  // least-damped mode neighborhood (~0.062i).
  "omega_targets": [
    [0.0, 0.00],
    [0.0, 0.02],
    [0.0, 0.04],
    [0.0, 0.05],
    [0.0, 0.055],
    [0.0, 0.060],
    [0.0, 0.06218175],
    [0.0, 0.065],
    [0.0, 0.070],
    [0.0, 0.080],
    [0.0, 0.100]
  ],

  "direct_ksp": {
    "type": "preonly",
    "pc_type": "lu",
    "pc_factor_solver_type": "mumps"
  }
}
